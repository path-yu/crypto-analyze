//@version=4
// ============================================================================
// PumpHunter —— 暴涨启动捕获（1h）
//
// 【复盘依据】6 个暴涨币、近一年 1h，共 94 段「3 天内自低点涨 ≥50%」的行情。
// 暴涨启动【确认 bar】相对全样本基线，区分度最高的特征：
//   · 成交量 / 96 根均量：中位 2.25 倍（基线 0.63）→ 3.6 倍差异   ← 最强
//   · 布林带宽：18.7%（基线 8.6%）/ ATR%：5.3%（基线 2.5%）
//   · 距 MA20：+6.1%（基线 -0.3%）；连阳根数：2（基线 0）
// 反直觉：**「突破 50 根新高」几乎无区分度**（暴涨 bar 相对 50 根新高中位 -10.4%，
// 基线 -6.7%）—— 暴涨币启动时仍在下跌结构里，上方套牢盘未收复，所以新高突破
// 捕获 79/94、却带来 999 段误报（精度 7%）。故入场不强制要求新高。
//
// 【入场】放量 + 脉冲涨幅 + 站上 MA20（可选叠加破 50 根新高）：
//   成交量 ≥ volMult × 96根均量
//   近 6 根涨幅 ≥ impPct%
//   收盘高于 MA20 且高出 ≥ distMaPct%
//
// 【离场】要点是「别在启动阶段被打掉、在掉头时把利润拿走」：
//   · 初始止损用**固定百分比**而不是 ATR —— 暴涨当下 ATR% 会被撑到 20%~50%，
//     3×ATR 等于 -100% 的"假止损"，实测会让 BANK/LAB/MYX 亏到 -80% 以上。
//   · 可选保本：浮盈达 bePct% 后把止损抬到成本价。
//   · 吊灯移动止损：止损 = max(止损, 持仓期最高价 × (1 − trailPct%))。
//   · 时间止损：持仓 maxBars 根仍未赚钱 → 视为假信号退出（重新等下一次放量）。
//   · 离场判定用「上一根收盘就已确定的止损」，绝不用本根的 high 设止损、
//     再用本根的 low 触发它（否则会凭空造出"刚进场就被打掉"的假信号）。
//
// 【仓位】固定名义价值 qty = notional / 价格，不做复利，便于逐笔归因。
// ============================================================================
strategy(title="PumpHunter", overlay=true, max_bars_back=500, initial_capital=1000, commission_value=0.055)

// ---------------- 入场参数 ----------------
float notional  = input(1000.0, "单笔名义价值 USDT", type=input.float)
float volMult   = input(5.0,  "成交量 / 96均量 ≥", type=input.float)
float bar1Pct   = input(12.0, "单根涨幅 ≥ % (0=关)", type=input.float)
float impPct    = input(0.0,  "近6根涨幅 ≥ % (0=关)", type=input.float)
float distMaPct = input(2.0,  "收盘距MA20 ≥ %", type=input.float)
float useBrk    = input(0.0,  "要求破50根新高(1/0)", type=input.float)

// ---------------- 离场参数 ----------------
float slPct     = input(12.0, "初始止损 %", type=input.float)
float bePct     = input(0.0,  "保本触发 % (0=关)", type=input.float)
float trailArm  = input(0.0,  "移动止损激活所需浮盈 % (0=立即)", type=input.float)
float trailPct  = input(10.0, "吊灯移动止损 %", type=input.float)
float maxBars   = input(96.0, "时间止损 K线数", type=input.float)

// ---------------- 指标 ----------------
volMa = sma(volume, 96)
volR  = volMa > 0 ? volume / volMa : 0
imp   = close / close[6] - 1
ma20  = sma(close, 20)
dist20 = ma20 > 0 ? close / ma20 - 1 : 0
hi50  = highest(high, 50)
brk   = close > hi50[1]

plot(ma20, color=color.orange)
plot(sma(close, 200), color=color.green)

entryCond = volR >= volMult and (bar1Pct < 0.5 or close / close[1] - 1 >= bar1Pct / 100) and (impPct < 0.5 or imp >= impPct / 100) and dist20 >= distMaPct / 100 and (useBrk < 0.5 or brk)

// ---------------- 状态 ----------------
// 必须用 `var`：Pine 里顶层 `x = 0` 是**每根 bar 重新初始化**的，只有 `var` 才会跨 bar 保留。
// （写成不带 var 的 `float stopPx = 0.0` 时，编译器会把它当逐 bar 标量放在 step 内部，
//  于是每根都从 0 开始 → 永远走「新成交初始化」分支、止损一次都不会触发。）
var float stopPx  = 0.0
var float entryPx = 0.0
var float hiSince = 0.0
var bool  armed   = false
var float heldN   = 0.0

if (strategy.position_size <= 0)
    // 空仓：状态复位。用 position_size 而不是自维护标志，避免预热期
    //「脚本自认为持仓、引擎实际空仓」的错位。
    stopPx := 0.0
    armed := false
    hiSince := 0.0
    heldN := 0.0
    entryPx := 0.0
else
    if (stopPx == 0)
        // 新成交那一根：按实际成交均价初始化止损（止损从下一根起生效）
        entryPx := strategy.position_avg_price
        stopPx := entryPx * (1 - slPct / 100)
        hiSince := high
        armed := false
        heldN := 0.0
    else
        // 1) 先用「上一根收盘时已确定」的止损判定离场
        if (low <= stopPx)
            strategy.close("P", comment="STOP " + tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and heldN >= maxBars and close <= entryPx)
            strategy.close("P", comment="TIME " + tostring(close))
            stopPx := 0.0

    // 2) 再用本根收盘信息更新止损，供下一根使用
    hiSince := math.max(hiSince, high)
    if (bePct > 0 and armed == false and high >= entryPx * (1 + bePct / 100))
        armed := true
    if (armed)
        stopPx := math.max(stopPx, entryPx)
    // 吊灯移动止损可设置「浮盈满 trailArm% 才激活」：假信号先用固定止损便宜地切掉，
    // 真爆发时再让移动止损接管，避免刚进场就被 12% 的回撤噪声打掉。
    if (trailArm <= 0 or hiSince >= entryPx * (1 + trailArm / 100))
        stopPx := math.max(stopPx, hiSince * (1 - trailPct / 100))
    heldN := heldN + 1

// 开仓（引擎在下一根开盘成交）
if (strategy.position_size <= 0 and entryCond)
    strategy.entry("P", strategy.long, qty=notional / close, comment="PUMP " + tostring(close))
