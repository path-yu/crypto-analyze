// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ===========================================================================
//  CVD 逼空策略 —— 单品种近似版
//  由 "CVD Short Squeeze Engine (Spot+Futures Divergence)" 改写，使其可以在
//  只提供单一品种量价数据的回测引擎中运行：
//    · 去掉 request.security 多品种取数：用图表自身 量 × 方向占比 近似 Taker Delta
//    · 「现货CVD 强 / 合约CVD 背离」→ 单品种下等价为「深跌而 CVD 未跟随走弱（承接）」
//    · 「持仓量 OI 暴增/退潮」→ 引擎无 OI 历史，改用 成交量暴增/退潮 作代理
//    · 资金费率沿用原脚本做法：手动输入，0 = 放行
//    · 止损/止盈锚定信号 K 线收盘价（引擎在信号次根开盘成交，与 TV 的
//      position_avg_price 口径存在一根 K 线的细微差异）
//  ⚠️ 单品种近似无法还原「现货与合约 CVD 背离」这一核心维度，回测结果
//     只能用于评估该框架（深跌反转 + 量能确认 + 风控离场），不代表原策略。
// ===========================================================================

//@version=6
strategy("CVD 逼空 · 单品种近似版", overlay=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=20, pyramiding=0, calc_on_every_tick=false)

// ------------------------- ① 输入参数 -------------------------
grpD = "① CVD 参数"
cvdLen      = input.int(200, "CVD 累积平滑长度", minval=10, group=grpD,
     tooltip="对 Delta 做 EMA 平滑后再累积，抑制单根噪音")
useWeighted = input.bool(true, "量-价-方向 加权估算 Delta", group=grpD,
     tooltip="用 |close-open| 占振幅比例加权成交量，近似主动方向强度")

grpV = "② 量能（替代持仓量 OI）"
useVol   = input.bool(true, "启用 量能暴增 过滤", group=grpV,
     tooltip="原策略用 OI 暴增判定新空头进场；无 OI 数据时以成交量暴增作代理")
volLen   = input.int(50, "量能基准均线长度", minval=5, group=grpV)
volSurge = input.float(1.30, "量能暴增倍数阈值", step=0.05, group=grpV)
volCool  = input.float(0.85, "量能退潮阈值(离场)", step=0.05, group=grpV)

grpF = "③ 资金费率 Funding"
useFunding    = input.bool(true, "启用资金费率过滤", group=grpF)
fundNegTh     = input.float(-0.05, "负费率阈值 (%)", step=0.01, group=grpF)
manualFunding = input.float(0.0, "手动输入当前资金费率 (%)", step=0.01, group=grpF,
     tooltip="填 0 表示放行该过滤器。回测引擎无资金费率历史，需人工设定")

grpP = "④ 价格 & 触发"
lookback = input.int(24, "『极端下跌』回溯窗口(根)", minval=5, group=grpP)
dropTh   = input.float(-3.0, "前期跌幅阈值 (%)", step=0.5, group=grpP)
brkLen   = input.int(20, "价格突破均线长度", minval=5, group=grpP)

grpR = "⑤ 风控 / 离场"
useSL    = input.bool(true, "启用止损", group=grpR)
slPct    = input.float(6.0, "止损 (%)", step=0.5, group=grpR)
useTP    = input.bool(true, "启用止盈", group=grpR)
tpPct    = input.float(45.0, "止盈 (%)", step=1.0, group=grpR)
maxBars  = input.int(200, "最长持仓(根) 0=不限", minval=0, group=grpR)

grpV2 = "⑥ 可视化"
showSignals = input.bool(true, "显示信号标记", group=grpV2)

// ------------------------- ② CVD 计算 -------------------------
// 近似 Taker Delta：K 线内部方向占比 × 成交量
rng   = high - low
dirv  = rng > 0 ? (close - open) / rng : 0.0
wgt   = useWeighted ? math.abs(dirv) : 1.0
delta = volume * dirv * wgt

// 先 EMA 平滑再累积，抑制单根噪音（与原脚本一致）
deltaEma = ta.ema(delta, cvdLen)
cvd      = ta.cum(deltaEma)

// 量能比率（替代 OI 比率）
volMa    = ta.sma(volume, volLen)
volRatio = volMa > 0 ? volume / volMa : 1.0

// ------------------------- ③ 条件合成 -------------------------
// 价格：窗口深跌 + 站上突破均线
pctChg   = (close - close[lookback]) / close[lookback] * 100
deepDrop = pctChg <= dropTh
pxMa     = ta.sma(close, brkLen)
isBreak  = close > pxMa

// CVD：主动买盘仍在推动（对应原「现货CVD 强买」）
cvdRising = cvd > cvd[1] and cvd > cvd[lookback]

// 资金费率判定（0 = 放行）
fRate  = useFunding ? manualFunding : 0.0
fundOK = not useFunding or fRate == 0.0 or fRate <= fundNegTh

// 量能判定（替代 OI：暴增 = 燃料）
volOK = not useVol or volRatio >= volSurge

// 建仓：深跌 + 站上均线 + CVD 仍在走强 + 量能暴增 + 费率放行
longCond = deepDrop and isBreak and cvdRising and volOK and fundOK

// 离场：量能退潮(空头投降) 或 价涨而 CVD 衰竭(买盘衰竭)
cvdBear  = close > close[1] and cvd < cvd[1] and cvd < cvd[5]
volCool_ = not useVol or volRatio <= volCool
exitCond = volCool_ or cvdBear

// 持仓根数自计（替代 strategy.opentrades.entry_bar_index，引擎按 na 降级）
var int heldBars = 0
heldBars := strategy.position_size != 0 ? heldBars + 1 : 0
timeExit = maxBars > 0 and strategy.position_size != 0 and heldBars >= maxBars

// ------------------------- ④ 交易执行 -------------------------
var float sqStop = na
var float sqTp = na

if longCond and strategy.position_size == 0
    strategy.entry("SqueezeLong", strategy.long)
    // 止损 / 止盈锚定信号 K 线收盘价（引擎在信号次根开盘成交）
    sqStop := close * (1 - slPct / 100)
    sqTp := close * (1 + tpPct / 100)

if strategy.position_size > 0
    if useSL
        strategy.exit("SL", "SqueezeLong", stop=sqStop)
    if useTP
        strategy.exit("TP", "SqueezeLong", limit=sqTp)
    if exitCond or timeExit
        strategy.close("SqueezeLong", comment=timeExit ? "超时" : "量能退潮/背离")

// ------------------------- ⑤ 可视化 -------------------------
plot(pxMa, "突破均线", color=color.new(color.gray, 40))
plotshape(showSignals and longCond, "逼空触发", shape.labelup,
     location=location.belowbar, color=color.new(color.red, 0), textcolor=color.white,
     text="SQUEEZE", size=size.small)
plotshape(showSignals and strategy.position_size > 0 and exitCond, "离场", shape.labeldown,
     location=location.abovebar, color=color.new(color.green, 0), textcolor=color.white,
     text="EXIT", size=size.small)
