// ══════════════════════════════════════════════════════════════════════════════
//  SwiftEdge GEX .· v1.0
//
//  Estimated dealer gamma exposure (GEX) that EVOLVES bar by bar, for any chart. Built only
//  from data TradingView has: the chart's price and volume, a volatility index (DVOL / VIX
//  family) or realised volatility, and the live options expiry calendar.
//
//  Simulation
//    · Every listed expiry has its own open interest per strike. An expiry is listed a fixed
//      time before it expires (daily 4 d, weekly 35 d, monthly 100 d, quarterly 370 d) and
//      disappears at expiry (crypto 08:00 UTC, US 20:00 UTC).
//    · Each step (default 30 min) positions are opened where price traded, weighted by
//      volume: calls above, puts below that price. Older positions are closed gradually.
//    · GEX(strike) = round-strike weight × Σ expiries (call OI − put OI) × gamma(price, strike,
//      volatility, time to expiry) × price² × 1 %. Dealers long calls, short puts (assumption).
//    · Warm-up: 120 days of daily bars are folded in when the simulation starts.
//  Strength is relative (strongest = 100). Levels, walls, regime and turning points are scale free.
// ══════════════════════════════════════════════════════════════════════════════
indicator("SwiftEdge GEX.", shorttitle = "SE GEX", overlay = true, max_bars_back = 5000, max_lines_count = 200, max_labels_count = 200, max_boxes_count = 500, max_polylines_count = 60)

// ── INPUTS ─────────────────────────────────────────────────────────────────────
gA = "Asset"
classIn = input.string("Auto", "Options market", options = ["Auto", "Crypto (Deribit style)", "US index / ETF (daily expiries)", "US stock / other (weekly expiries)"], group = gA, tooltip = "Decides the expiry calendar. Auto: crypto charts use the crypto calendar; SPX, NDX, SPY, QQQ, IWM and their futures/CFDs get daily expiries; everything else weekly.")
volIn   = input.string("Auto", "Volatility source", options = ["Auto", "Volatility index", "Realised 20 days", "Manual"], group = gA, tooltip = "Auto uses a volatility index when one exists for the asset (DVOL, VIX, VXN, RVX, GVZ ...), otherwise realised volatility.")
volSym  = input.symbol("", "Volatility index (blank = automatic)", group = gA)
volMan  = input.float(50.0, "Manual volatility (%)", minval = 1, maxval = 300, group = gA)

gS = "Simulation"
simDays = input.int(14, "Simulate the last N days bar by bar", minval = 2, maxval = 90, group = gS, tooltip = "Older history (120 days of daily bars) is folded in when the simulation starts.")
stepMin = input.int(30, "Simulation step (minutes)", options = [15, 30, 60, 240, 1440], group = gS)
roundEm = input.float(0.35, "Round-strike emphasis", minval = 0, maxval = 2, step = 0.05, group = gS, tooltip = "How much more open interest round strikes collect. Lower values spread open interest over more strikes and show more, closer zones.")

gH = "GEX heatmap"
showHeat = input.bool(true, "GEX heatmap over time", group = gH)
heatW    = input.int(3, "Line width", minval = 1, maxval = 10, group = gH)
heatMin  = input.int(3, "Hide strikes weaker than (% of strongest)", minval = 0, maxval = 90, group = gH)
heatStrong = input.int(0, "Strongest strike transparency", minval = 0, maxval = 80, group = gH)
heatWeak   = input.int(55, "Weakest shown strike transparency", minval = 0, maxval = 95, group = gH)
heatBoost  = input.float(0.8, "Contrast (1 = linear, lower lifts weak strikes)", minval = 0.2, maxval = 2.0, step = 0.05, group = gH)
heatThick  = input.float(0.6, "Thick line from strength (0-1)", minval = 0, maxval = 1, step = 0.05, group = gH)
heatThickAdd = input.int(3, "Extra width for strong strikes", minval = 0, maxval = 10, group = gH)
heatMode = input.string("Per bar", "Colour scale", options = ["Per bar", "Rolling"], group = gH, tooltip = "Per bar: the strongest strike on each bar is full colour. Rolling: the strongest level of the recent period sets full colour, so bands strengthen into expiry and fade after it (an expiry spike can wash out the rest).")
heatHL   = input.float(1.0, "Rolling memory (days)", minval = 0.1, maxval = 30, step = 0.1, group = gH)
posCol   = input.color(#ffb300, "Positive GEX", group = gH)
negCol   = input.color(#9a5aff, "Negative GEX", group = gH)
showTop  = input.bool(true, "Label the strongest strikes now", group = gH)
nTop     = input.int(5, "Number of labels", minval = 1, maxval = 15, group = gH)

gL = "Key levels"
showWall  = input.bool(true, "Call wall / put wall over time", group = gL)
showWall0 = input.bool(true, "Call wall / put wall, expiry within 24 h", group = gL)
showFlip  = input.bool(true, "Gamma flip (now)", group = gL)
wallCol   = input.color(#ffb300, "Walls", group = gL)
wall0Col  = input.color(#00e5ff, "Walls, within 24 h", group = gL)
flipCol   = input.color(#e6edf3, "Gamma flip", group = gL)

gQ = "Liquidity (simulated)"
showLiq   = input.bool(true, "Liquidity heatmap", group = gQ, tooltip = "Resting order-book liquidity simulated from the shape of a real order book (distance from price and round levels), drawn across the visible chart.")
liqCols   = input.int(36, "Columns across the screen", minval = 5, maxval = 60, group = gQ)
liqLevels = input.int(13, "Levels per column", minval = 4, maxval = 30, group = gQ)
liqRange  = input.float(1.8, "Range ± % of price", minval = 0.3, maxval = 1.8, step = 0.1, group = gQ)
liqProf   = input.bool(true, "Liquidity profile now (right of the last bar)", group = gQ)
liqProfLen = input.int(14, "Profile length (bars)", minval = 4, maxval = 60, group = gQ)
liqBid    = input.color(#5cc8ff, "Bids (below price)", group = gQ)
liqAsk    = input.color(#ff7a8f, "Asks (above price)", group = gQ)
liqStrong = input.int(15, "Strongest level transparency", minval = 0, maxval = 80, group = gQ)
liqWeak   = input.int(94, "Weakest level transparency", minval = 30, maxval = 99, group = gQ)
liqContrast = input.float(2.2, "Contrast (higher = only big walls stand out)", minval = 0.5, maxval = 5, step = 0.1, group = gQ)
liqThick  = input.bool(true, "Thicker bands for more liquidity", group = gQ)
liqHeight = input.float(0.16, "Band height (share of level step)", minval = 0.1, maxval = 1, step = 0.05, group = gQ)

gD = "Dealer desk"
showDesk   = input.bool(true, "Hedge wedge: how hard dealers must trade if price goes there", group = gD)
showLadder = input.bool(true, "Number ladder", group = gD)
showPct    = input.bool(true, "±1 % markers", group = gD)
showTurns  = input.bool(true, "Turning points", group = gD)
showCard   = input.bool(true, "Regime card", group = gD)
showTint   = input.bool(true, "Regime tint behind the desk", group = gD)
cardPos    = input.string("Bottom left", "Card position", options = ["Top right", "Top left", "Top center", "Bottom right", "Bottom left", "Middle right"], group = gD)
cardSize   = input.string("Small", "Card text size", options = ["Tiny", "Small", "Normal"], group = gD)
deskMode   = input.string("Fit to zoom", "Desk range", options = ["Fit to zoom", "Fixed ± %"], group = gD, tooltip = "Fit to zoom: the desk covers the visible price range and sits at the right edge of the screen, like the depth. It recalculates when you zoom or scroll.")
deskRange  = input.float(2.5, "Fixed range ± % of price", minval = 0.5, maxval = 15, step = 0.5, group = gD)
deskOffset = input.int(90, "Desk axis N bars right of the last bar", minval = 10, maxval = 450, group = gD)
deskWidth  = input.int(40, "Wedge width (bars, fixed mode)", minval = 5, maxval = 300, group = gD)
deskWidthPct = input.float(9, "Wedge width (% of screen, zoom mode)", minval = 3, maxval = 40, group = gD)
ladderN    = input.int(10, "Numbers on the ladder (about)", minval = 3, maxval = 30, group = gD)
deskText   = input.string("Small", "Desk text size", options = ["Tiny", "Small", "Normal"], group = gD)
wedgeFill  = input.int(70, "Wedge fill transparency", minval = 0, maxval = 100, group = gD)
colDamp    = input.color(#2ee6a8, "Dampen below price (dealers buy)", group = gD)
colDampUp  = input.color(#ff8a4c, "Dampen above price (dealers sell)", group = gD)
colAmp     = input.color(#ff64c8, "Amplify", group = gD)
colPanel   = input.color(color.new(#0b0f14, 6), "Card background", group = gD)
colText    = input.color(#e6edf3, "Card text", group = gD)

// ── MODEL CONSTANTS ──────────────────────────────────────────────────────────────
R_W  = array.from(1.8, 4.7, 7.4, 3.9)       // extra weight: strikes that are multiples of nice(price × 0.6 / 1.2 / 3 / 6 %)
R_F  = array.from(0.006, 0.012, 0.03, 0.06)
T_W  = array.from(1, 1, 1, 1)       // new positions per day, per expiry type (daily, weekly, monthly, quarterly)
T_HL = array.from(2, 10, 30, 100)      // half-life (days) of open positions, per expiry type
T_B  = array.from(0.02, 0.03, 0.045, 0.05)       // spread of new positions around price (log), per expiry type
T_S  = array.from(0.01, 0.02, 0.05, 0.1)       // calls opened above, puts below price (log), per expiry type
HOR  = array.from(4.0, 35.0, 100.0, 370.0)   // listed this many days before expiry
ALPHA = 0.3               // relative volume exponent
PUTW  = 0.8                // put weight relative to calls
NS = 24                         // expiry slots
NK = 360                        // strikes: 60 % to 150 % of the start price

// ── WHICH OPTIONS MARKET ─────────────────────────────────────────────────────────
inList(string s, string csv) => str.contains("," + csv + ",", "," + s + ",")
TK = str.upper(syminfo.ticker)
RT = str.upper(syminfo.root)
BASE = str.upper(syminfo.basecurrency)
IS_CRYPTO = classIn == "Crypto (Deribit style)" or (classIn == "Auto" and syminfo.type == "crypto")
IDX_DAILY = classIn == "US index / ETF (daily expiries)" or (classIn == "Auto" and not IS_CRYPTO and (inList(TK, "SPX,SPY,QQQ,IWM,NDX,XSP,SPX500,US500,SPX500USD,NAS100,US100,NAS100USD,USTEC,US2000") or inList(RT, "ES,MES,NQ,MNQ,RTY,M2K")))
EXP_HOUR = IS_CRYPTO ? 8 : 20
autoVol() =>
    string s = ""
    if IS_CRYPTO
        s := BASE == "BTC" or BASE == "XBT" ? "DERIBIT:DVOL" : BASE == "ETH" ? "DERIBIT:ETHDVOL" : ""
    else
        s := inList(TK, "SPX,SPY,XSP,SPX500,US500,SPX500USD") or inList(RT, "ES,MES") ? "CBOE:VIX" : inList(TK, "NDX,QQQ,NAS100,US100,NAS100USD,USTEC") or inList(RT, "NQ,MNQ") ? "CBOE:VXN" : inList(TK, "IWM,RUT,US2000") or inList(RT, "RTY,M2K") ? "CBOE:RVX" : inList(TK, "DIA,DJI,US30") or inList(RT, "YM,MYM") ? "CBOE:VXD" : inList(TK, "GLD,XAUUSD,GOLD") or inList(RT, "GC,MGC") ? "CBOE:GVZ" : inList(TK, "SLV,XAGUSD,SILVER") or inList(RT, "SI,SIL") ? "CBOE:VXSLV" : TK == "AAPL" ? "CBOE:VXAPL" : TK == "AMZN" ? "CBOE:VXAZN" : TK == "GOOGL" or TK == "GOOG" ? "CBOE:VXGOG" : inList(TK, "USO,CL,WTI,USOIL") or inList(RT, "CL,MCL") ? "CBOE:OVX" : ""
    s
VOL_SYM = volSym != "" ? volSym : autoVol()

// daily history of COMPLETED days (newest last): close, volume, close time
dayHist() =>
    var array<float> c = array.new<float>()
    var array<float> v = array.new<float>()
    var array<float> tt = array.new<float>()
    if not na(close[1])
        c.push(close[1])
        v.push(nz(volume[1]))
        tt.push(time_close[1])
        if c.size() > 120
            c.shift()
            v.shift()
            tt.shift()
    [c, v, tt]
[DC, DV, DT] = request.security(syminfo.tickerid, "D", dayHist(), lookahead = barmerge.lookahead_off)
dayRet = request.security(syminfo.tickerid, "D", ta.stdev(math.log(close[1] / close[2]), 20), lookahead = barmerge.lookahead_off)
volIdx = request.security(VOL_SYM == "" ? syminfo.tickerid : VOL_SYM, "D", close, ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
realised = dayRet * math.sqrt(IS_CRYPTO ? 365.0 : 252.0)
useIdx = (volIn == "Auto" or volIn == "Volatility index") and VOL_SYM != "" and not na(volIdx) and volIdx > 0
IV = volIn == "Manual" ? volMan / 100 : useIdx ? volIdx / 100 : nz(realised, 0.5)
IV_SRC = volIn == "Manual" ? "manual" : useIdx ? VOL_SYM : "realised 20d"

// ── MATHS ──────────────────────────────────────────────────────────────────────
YEAR_MS = 365.0 * 86400000.0
DAY_MS  = 86400000.0
npdf(float x) => math.exp(-0.5 * x * x) / math.sqrt(2.0 * math.pi)
niceStep(float x) =>
    p = math.pow(10, math.floor(math.log10(x)))
    m = x / p
    (m < 1.5 ? 1.0 : m < 2.25 ? 2.0 : m < 3.75 ? 2.5 : m < 7.5 ? 5.0 : 10.0) * p
gam(float S, float k, float v, float T) =>
    sq = v * math.sqrt(T)
    npdf((math.log(S / k) + 0.5 * v * v * T) / sq) / (S * sq)

// expiry Friday of a month: last Friday (crypto) or 3rd Friday (US), at the expiry hour
monthExpiry(int yy, int mm) =>
    float e = na
    if IS_CRYPTO
        ny = mm == 12 ? yy + 1 : yy
        nm = mm == 12 ? 1 : mm + 1
        last = timestamp("UTC", ny, nm, 1, EXP_HOUR, 0) - DAY_MS
        wd = dayofweek(int(last), "UTC")
        e := last - ((wd - dayofweek.friday + 7) % 7) * DAY_MS
    else
        first = timestamp("UTC", yy, mm, 1, EXP_HOUR, 0)
        wd = dayofweek(first, "UTC")
        e := first + (((dayofweek.friday - wd + 7) % 7) + 14) * DAY_MS
    e

// expiries listed at time t: [times, types] (0 daily, 1 weekly, 2 monthly, 3 quarterly)
listedAt(float t) =>
    et = array.new<float>()
    ty = array.new<int>()
    d0 = math.floor(t / DAY_MS) * DAY_MS + EXP_HOUR * 3600000.0
    y = year(int(t), "UTC")
    m = month(int(t), "UTC")
    for i = 0 to 36
        e = d0 + i * DAY_MS
        ei = int(e)
        wd = dayofweek(ei, "UTC")
        if e > t + 900000 and wd != dayofweek.saturday and wd != dayofweek.sunday
            fri = wd == dayofweek.friday
            mE = monthExpiry(year(ei, "UTC"), month(ei, "UTC"))
            if not (fri and math.abs(e - mE) < 3600000)
                tt = fri ? 1 : 0
                if e - t <= HOR.get(tt) * DAY_MS and (tt == 1 or IS_CRYPTO or IDX_DAILY)
                    et.push(e)
                    ty.push(tt)
    for k = 0 to 12
        mm = (m - 1 + k) % 12 + 1
        yy = y + int(math.floor((m - 1 + k) / 12))
        e = monthExpiry(yy, mm)
        tt = mm % 3 == 0 ? 3 : 2
        if e > t + 900000 and e - t <= HOR.get(tt) * DAY_MS
            et.push(e)
            ty.push(tt)
    [et, ty]

// ── SIMULATION STATE ───────────────────────────────────────────────────────────
var matrix<float> OC = matrix.new<float>(NS, NK, 0.0)
var matrix<float> OP = matrix.new<float>(NS, NK, 0.0)
var array<float> SE  = array.new<float>(NS, na)       // expiry time per slot
var array<int>   STY = array.new<int>(NS, 0)          // expiry type per slot
var array<float> SC  = array.new<float>(NS, 1.0)      // lazy decay: true OI = stored OI × SC
var array<float> RW  = array.new<float>(NK, 1.0)      // round-strike weight
var array<float> LK  = array.new<float>(NK, 0.0)      // log strike
var float U   = na
var float KLO = na
var bool  started = false
var float lastStepT = na
var float accV  = 0.0
var float accPV = 0.0
var float avgDayV = na

strikeAt(int j) => KLO + j * U

syncSlots(float t) =>
    for s = 0 to NS - 1
        e = SE.get(s)
        if not na(e) and e <= t
            SE.set(s, na)
            SC.set(s, 1.0)
            for j = 0 to NK - 1
                OC.set(s, j, 0.0)
                OP.set(s, j, 0.0)
    [et, ty] = listedAt(t)
    for i = 0 to et.size() - 1
        e = et.get(i)
        if SE.indexof(e) < 0
            int free = -1
            for s = 0 to NS - 1
                if na(SE.get(s))
                    free := s
                    break
            if free >= 0
                SE.set(free, e)
                STY.set(free, ty.get(i))

simStep(float t, float P, float dtDays, float vrel) =>
    syncSlots(t)
    lp = math.log(P)
    vv = math.pow(math.max(vrel, 1e-3), ALPHA) * dtDays
    // kernels per expiry type, only where they matter (|z| < 4)
    kc = matrix.new<float>(4, NK, 0.0)
    kp = matrix.new<float>(4, NK, 0.0)
    jLo = array.new<int>(4, 0)
    jHi = array.new<int>(4, -1)
    for tt = 0 to 3
        b  = T_B.get(tt)
        sh = math.abs(T_S.get(tt))
        a = math.max(0, int(math.floor((P * math.exp(-sh - 4 * b) - KLO) / U)))
        z = math.min(NK - 1, int(math.ceil((P * math.exp(sh + 4 * b) - KLO) / U)))
        jLo.set(tt, a)
        jHi.set(tt, z)
        if z >= a
            for j = a to z
                zc = (LK.get(j) - lp - T_S.get(tt)) / b
                zp = (LK.get(j) - lp + T_S.get(tt)) / b
                kc.set(tt, j, math.exp(-0.5 * zc * zc))
                kp.set(tt, j, math.exp(-0.5 * zp * zp))
    for s = 0 to NS - 1
        if not na(SE.get(s))
            tt  = STY.get(s)
            sc  = SC.get(s) * math.pow(0.5, dtDays / T_HL.get(tt))
            add = T_W.get(tt) * vv / sc
            a = jLo.get(tt)
            z = jHi.get(tt)
            if z >= a
                for j = a to z
                    OC.set(s, j, OC.get(s, j) + add * kc.get(tt, j))
                    OP.set(s, j, OP.get(s, j) + add * kp.get(tt, j))
            if sc < 1e-9
                for j = 0 to NK - 1
                    OC.set(s, j, OC.get(s, j) * sc)
                    OP.set(s, j, OP.get(s, j) * sc)
                SC.set(s, 1.0)
            else
                SC.set(s, sc)

// GEX at strike index j for price S at time t: [net, call part, put part, call <24h, put <24h]
gexAt(int j, float S, float t) =>
    float c = 0.0
    float p = 0.0
    float c0 = 0.0
    float p0 = 0.0
    k = strikeAt(j)
    for s = 0 to NS - 1
        e = SE.get(s)
        if not na(e) and e > t + 900000
            T  = math.max((e - t) / YEAR_MS, 15.0 * 60000.0 / YEAR_MS)
            gm = gam(S, k, IV, T) * S * S * 0.01 * RW.get(j)
            cc = OC.get(s, j) * SC.get(s) * gm
            pp = OP.get(s, j) * SC.get(s) * gm * PUTW
            c += cc
            p += pp
            if e - t < DAY_MS
                c0 += cc
                p0 += pp
    [c - p, c, p, c0, p0]

// total gamma at price P (for flip, wedge and turning points), strikes jA..jB
totalGamma(float P, float t, int jA, int jB) =>
    float tot = 0.0
    for s = 0 to NS - 1
        e = SE.get(s)
        if not na(e) and e > t + 900000
            T = math.max((e - t) / YEAR_MS, 15.0 * 60000.0 / YEAR_MS)
            sc = SC.get(s)
            for j = jA to jB
                tot += (OC.get(s, j) - OP.get(s, j) * PUTW) * sc * RW.get(j) * gam(P, strikeAt(j), IV, T)
    tot

// ── RUN THE SIMULATION ─────────────────────────────────────────────────────────
startT = timenow - simDays * DAY_MS
if not started and time >= startT and DC.size() >= 10
    started := true
    S0 = close
    U   := niceStep(S0 * 0.006) / 2
    KLO := math.floor(S0 * 0.6 / U) * U
    for j = 0 to NK - 1
        k = KLO + j * U
        LK.set(j, math.log(k))
        float w = 1.0
        for r = 0 to 3
            L = niceStep(S0 * R_F.get(r))
            q = k / L
            if math.abs(q - math.round(q)) < 1e-6
                w += R_W.get(r) * roundEm
        RW.set(j, w)
    // warm-up from the daily history
    float vm = 0.0
    for d = 0 to DV.size() - 1
        vm += DV.get(d)
    vm := vm / DV.size()
    avgDayV := vm
    stepD = IS_CRYPTO ? 1.0 : 7.0 / 5.0
    for d = 0 to DC.size() - 1
        simStep(DT.get(d), DC.get(d), stepD, vm > 0 ? DV.get(d) / vm : 1.0)
    lastStepT := time
if started
    accV  += nz(volume)
    accPV += nz(volume) * hlc3
    if time_close - lastStepT >= stepMin * 60000
        dtD = (time_close - lastStepT) / DAY_MS
        P = accV > 0 ? accPV / accV : close
        vr = accV > 0 and nz(avgDayV) > 0 ? accV / (avgDayV * dtD) : 1.0
        simStep(time_close, P, dtD, vr)
        lastStepT := time_close
        accV := 0.0
        accPV := 0.0

// ── HEATMAP OVER TIME ──────────────────────────────────────────────────────────
jc = started ? int(math.round((close - KLO) / U)) : 0
var float scaleMax = 0.0
array<float> HV = array.new<float>(14, na)
array<float> HL = array.new<float>(14, na)
array<float> HS = array.new<float>(14, na)
array<bool>  HC = array.new<bool>(14, false)
var array<float> PREVL = array.new<float>(14, na)
if started and showHeat and jc - 7 >= 0 and jc + 7 < NK
    float mxBar = 0.0
    lo = jc - 7
    for i = 0 to 14 - 1
        // each line keeps its own strike while it is on screen (strike index j ≡ i mod slots), so it never breaks
        j = lo + ((i - lo) % 14 + 14) % 14
        [g, gc_, gp_, gc0_, gp0_] = gexAt(j, close, time)
        k = strikeAt(j)
        HV.set(i, g)
        HL.set(i, k)
        HC.set(i, k != PREVL.get(i))
        PREVL.set(i, k)
        mxBar := math.max(mxBar, math.abs(g))
    barDays = timeframe.in_seconds() / 86400.0
    scaleMax := heatMode == "Per bar" ? mxBar : math.max(mxBar, scaleMax * math.pow(0.5, barDays / heatHL))
    for i = 0 to 14 - 1
        HS.set(i, scaleMax > 0 ? math.min(1.0, math.abs(HV.get(i)) / scaleMax) : 0.0)
// colour: dark and transparent for weak strikes, bright for strong ones
heatColor(int i) =>
    g = HV.get(i)
    sh = HS.get(i)
    color c = na
    if not na(g) and not na(sh) and sh * 100 >= heatMin
        x = math.pow(sh, heatBoost)
        base = g >= 0 ? posCol : negCol
        c := color.from_gradient(x, 0, 1, color.new(color.from_gradient(0.55, 0, 1, base, #0b0f14), heatWeak), color.new(base, heatStrong))
    c
heatLevel(int i) => HC.get(i) ? na : HL.get(i)
heatStrongLevel(int i) => HC.get(i) or nz(HS.get(i)) < heatThick ? na : HL.get(i)
plot(showHeat ? heatLevel(0) : na, "GEX strike 1", heatColor(0), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(1) : na, "GEX strike 2", heatColor(1), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(2) : na, "GEX strike 3", heatColor(2), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(3) : na, "GEX strike 4", heatColor(3), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(4) : na, "GEX strike 5", heatColor(4), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(5) : na, "GEX strike 6", heatColor(5), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(6) : na, "GEX strike 7", heatColor(6), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(7) : na, "GEX strike 8", heatColor(7), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(8) : na, "GEX strike 9", heatColor(8), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(9) : na, "GEX strike 10", heatColor(9), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(10) : na, "GEX strike 11", heatColor(10), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(11) : na, "GEX strike 12", heatColor(11), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(12) : na, "GEX strike 13", heatColor(12), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatLevel(13) : na, "GEX strike 14", heatColor(13), heatW, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(0) : na, "GEX strong 1", heatColor(0), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(1) : na, "GEX strong 2", heatColor(1), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(2) : na, "GEX strong 3", heatColor(2), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(3) : na, "GEX strong 4", heatColor(3), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(4) : na, "GEX strong 5", heatColor(4), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(5) : na, "GEX strong 6", heatColor(5), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(6) : na, "GEX strong 7", heatColor(6), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(7) : na, "GEX strong 8", heatColor(7), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(8) : na, "GEX strong 9", heatColor(8), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(9) : na, "GEX strong 10", heatColor(9), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(10) : na, "GEX strong 11", heatColor(10), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(11) : na, "GEX strong 12", heatColor(11), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(12) : na, "GEX strong 13", heatColor(12), heatW + heatThickAdd, plot.style_linebr, display = display.pane)
plot(showHeat ? heatStrongLevel(13) : na, "GEX strong 14", heatColor(13), heatW + heatThickAdd, plot.style_linebr, display = display.pane)

// ── WALLS OVER TIME (updated every simulation step) ─────────────────────────────
var float cwV = na
var float pwV = na
var float cw0V = na
var float pw0V = na
if started and (time_close - lastStepT < 1 or barstate.islast)
    jA = math.max(0, jc - int(math.round(0.12 * close / U)))
    jB = math.min(NK - 1, jc + int(math.round(0.12 * close / U)))
    float bc = 0.0
    float bp = 0.0
    float bc0 = 0.0
    float bp0 = 0.0
    float a1 = na
    float a2 = na
    float a3 = na
    float a4 = na
    float vc = 0.0
    float vp = 0.0
    float vc0 = 0.0
    float vp0 = 0.0
    for j = jA to jB
        [g, c, p, c0, p0] = gexAt(j, close, time)
        k = strikeAt(j)
        if c > bc
            bc := c
            a1 := k
        if p > bp
            bp := p
            a2 := k
        if c0 > bc0
            bc0 := c0
            a3 := k
        if p0 > bp0
            bp0 := p0
            a4 := k
        // value at the current wall, for hysteresis
        if k == cwV
            vc := c
        if k == pwV
            vp := p
        if k == cw0V
            vc0 := c0
        if k == pw0V
            vp0 := p0
    // a new wall must be 15 % stronger than the current one before it takes over
    cwV  := na(cwV) or vc <= 0 or bc > vc * 1.15 ? a1 : cwV
    pwV  := na(pwV) or vp <= 0 or bp > vp * 1.15 ? a2 : pwV
    cw0V := na(cw0V) or vc0 <= 0 or bc0 > vc0 * 1.15 ? a3 : cw0V
    pw0V := na(pw0V) or vp0 <= 0 or bp0 > vp0 * 1.15 ? a4 : pw0V
// a wall that moves breaks the line instead of drawing a vertical jump
cwB  = cwV != cwV[1] ? na : cwV
pwB  = pwV != pwV[1] ? na : pwV
cw0B = cw0V != cw0V[1] ? na : cw0V
pw0B = pw0V != pw0V[1] ? na : pw0V
plot(showWall ? cwB : na, "Call wall", wallCol, 2, plot.style_linebr)
plot(showWall ? pwB : na, "Put wall", color.new(wallCol, 30), 2, plot.style_linebr)
plot(showWall0 ? cw0B : na, "Call wall <24h", wall0Col, 1, plot.style_linebr)
plot(showWall0 ? pw0B : na, "Put wall <24h", color.new(wall0Col, 30), 1, plot.style_linebr)

// ── SIMULATED LIQUIDITY: book shape trained on recorded order books (distance band × round level) ──
LQ_B   = array.from(0.1, 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.8)   // distance bands (% of price)
LQ_BID = array.from(-0.16973, 0.10712, -0.29794, -0.71673, -0.3689, -0.013943, 0.12361, -0.48201)
LQ_ASK = array.from(0.0098747, 0.06769, -0.40421, -0.78435, -0.46432, -0.14987, 0.016628, -0.71567)
LQ_F   = array.from(0.0012, 0.003, 0.006, 0.012, 0.06)            // round levels: nice(price × f)
LQ_R   = array.from(0.25764, -0.012581, 0.58702, 0.65388, 0.77422)
liqAt(float P, float S) =>
    d  = (P - S) / S * 100
    ad = math.abs(d)
    float y = na
    if ad > 0.02 and ad <= liqRange
        int b = 7
        for q = 0 to 7
            if ad <= LQ_B.get(q)
                b := q
                break
        y := d < 0 ? LQ_BID.get(b) : LQ_ASK.get(b)
        int kl = 0
        for r = 0 to 4
            L = niceStep(S * LQ_F.get(r))
            x = P / L
            if math.abs(x - math.round(x)) < 1e-6
                kl := r + 1
        if kl > 0
            y += LQ_R.get(kl - 1)
    na(y) ? 0.0 : math.exp(y)
// visibility 0..1: from the weakest to the strongest level on screen, with a contrast curve (big walls bright, the rest dim)
liqShade(float v, float vmin, float vmax) =>
    r = vmax > vmin ? math.max(0.0, math.min(1.0, (v - vmin) / (vmax - vmin))) : 1.0
    math.pow(r, liqContrast)

// ── NOW: labels, flip, dealer desk and card (last bar) ─────────────────────────
fmtPx(float p) => math.abs(p) >= 1000 ? str.tostring(math.round(p), "#,###") : math.abs(p) >= 1 ? str.tostring(p, "#,##0.##") : str.tostring(p, "0.####")
buySell(float v) => v >= 0 ? "buy" : "sell"
rel(float v, float mx) => math.round(100 * math.abs(v) / mx)
xAt(float v, int tR, float mx, int wdt, int tf) => int(tR - math.round(math.min(1.0, math.abs(v) / mx) * wdt * tf))
hAt(array<float> H, float glo, float st, float p) =>
    f = (p - glo) / st
    i = int(math.floor(f))
    float r = na
    if i >= 0 and i < H.size() - 1
        r := H.get(i) + (H.get(i + 1) - H.get(i)) * (f - i)
    r
cardPosition() => cardPos == "Top left" ? position.top_left : cardPos == "Top center" ? position.top_center : cardPos == "Bottom right" ? position.bottom_right : cardPos == "Bottom left" ? position.bottom_left : cardPos == "Middle right" ? position.middle_right : position.top_right

var array<line>     lines  = array.new<line>()
var array<label>    labels = array.new<label>()
var array<box>      boxes  = array.new<box>()
var array<polyline> polys  = array.new<polyline>()
var array<table>    cards  = array.new<table>()

if barstate.islast and started
    for l in lines
        line.delete(l)
    for lb in labels
        label.delete(lb)
    for b in boxes
        box.delete(b)
    for pl in polys
        polyline.delete(pl)
    array.clear(lines)
    array.clear(labels)
    array.clear(boxes)
    array.clear(polys)
    S   = close
    now = timenow
    // ── simulated liquidity heatmap across the visible chart + profile now ──
    if showLiq or liqProf
        lv2 = chart.left_visible_bar_time
        int visB = 0
        float vH = high
        float vL = low
        for i = 0 to math.min(bar_index, 4999)
            if time[i] < lv2
                break
            visB += 1
            vH := math.max(vH, high[i])
            vL := math.min(vL, low[i])
        // level step follows the zoom (about 30 levels on screen), never finer than the recorded book (≈0.03 % of price)
        lstep = math.max(niceStep(S * 0.0003), niceStep((vH - vL) / 30))
        vPad = (vH - vL) * 0.08
        // at most ~490 boxes in total
        nCols = math.max(5, math.min(liqCols, int(490 / liqLevels)))
        colB = math.max(1, int(math.ceil(visB / nCols)))
        // global scale over what is drawn, so columns compare with each other
        float lmx = 1e-12
        float lmn = 1e12
        for c = 0 to nCols - 1
            k = c * colB
            if k <= math.min(bar_index, 4999)
                Sc = close[k]
                for q = -int(liqRange / 100 * Sc / lstep) to int(liqRange / 100 * Sc / lstep)
                    Pq = math.round(Sc / lstep) * lstep + q * lstep
                    if Pq > vL - vPad and Pq < vH + vPad
                        lv_ = liqAt(Pq, Sc)
                        if lv_ > 0
                            lmx := math.max(lmx, lv_)
                            lmn := math.min(lmn, lv_)
        if showLiq
            for c = 0 to nCols - 1
                k = c * colB
                if k <= math.min(bar_index, 4999) - colB
                    Sc = close[k]
                    base = math.round(Sc / lstep) * lstep
                    nq = int(liqRange / 100 * Sc / lstep)
                    lvls = array.new<float>()
                    vals = array.new<float>()
                    for q = -nq to nq
                        P = base + q * lstep
                        v = P > vL - vPad and P < vH + vPad ? liqAt(P, Sc) : 0.0
                        if v > 0
                            lvls.push(P)
                            vals.push(v)
                    ord = vals.sort_indices(order.descending)
                    for m = 0 to math.min(liqLevels, ord.size()) - 1
                        P = lvls.get(ord.get(m))
                        x = liqShade(vals.get(ord.get(m)), lmn, lmx)
                        col = color.new(P < Sc ? liqBid : liqAsk, liqWeak - x * (liqWeak - liqStrong))
                        hh = lstep * liqHeight / 2 * (liqThick ? 0.35 + 1.3 * x : 1.0)
                        boxes.push(box.new(bar_index - k - colB + 1, P + hh, bar_index - k + 1, P - hh, border_color = color.new(col, 100), border_width = 0, bgcolor = col))
        if liqProf
            nq = int(liqRange / 100 * S / lstep)
            base = math.round(S / lstep) * lstep
            for q = -nq to nq
                P = base + q * lstep
                v = P > vL - vPad and P < vH + vPad ? liqAt(P, S) : 0.0
                if v > 0
                    sh = liqShade(v, lmn, lmx)
                    col = color.new(P < S ? liqBid : liqAsk, liqWeak - sh * (liqWeak - liqStrong))
                    lines.push(line.new(bar_index + 1, P, bar_index + 1 + int(math.max(1, math.round(sh * liqProfLen))), P, color = col, width = 3))
    // strongest strikes now
    if showTop
        js = array.new<int>()
        gs = array.new<float>()
        for j = math.max(0, jc - int(0.03 * S / U)) to math.min(NK - 1, jc + int(0.03 * S / U))
            [g, c, p, c0, p0] = gexAt(j, S, now)
            js.push(j)
            gs.push(math.abs(g))
        ord = gs.sort_indices(order.descending)
        top = gs.size() > 0 ? math.max(gs.get(ord.get(0)), 1e-12) : 1.0
        for q = 0 to math.min(nTop, ord.size()) - 1
            j = js.get(ord.get(q))
            [g, c, p, c0, p0] = gexAt(j, S, now)
            labels.push(label.new(bar_index + (liqProf ? liqProfLen + 3 : 2), strikeAt(j), "GEX " + fmtPx(strikeAt(j)) + " " + (g >= 0 ? "+" : "−") + str.tostring(math.round(100 * math.abs(g) / top)), style = label.style_label_left, color = color.new(#0b0f14, 30), textcolor = g >= 0 ? posCol : negCol, size = size.small))
    tf = timeframe.in_seconds() * 1000
    // desk range and position: follow the zoom (visible bars) like the depth, or a fixed ± %
    float dLo = S * (1 - deskRange / 100)
    float dHi = S * (1 + deskRange / 100)
    int tR = time + deskOffset * tf
    int wBars = deskWidth
    if deskMode == "Fit to zoom"
        lv = chart.left_visible_bar_time
        rv = chart.right_visible_bar_time
        float vh = high
        float vl = low
        for i = 0 to math.min(bar_index, 4999)
            if time[i] < lv
                break
            vh := math.max(vh, high[i])
            vl := math.min(vl, low[i])
        pad = (vh - vl) * 0.06
        dLo := math.max(S * 0.85, math.min(vl - pad, S * 0.997))
        dHi := math.min(S * 1.15, math.max(vh + pad, S * 1.003))
        visBars = math.max(20, (rv - lv) / tf)
        wBars := int(math.max(8, visBars * deskWidthPct / 100))
        need = int(wBars * 2.2) + 6                       // wedge + number column
        tR := rv > time + need * tf ? int(rv - 3 * tf) : time + int(math.max(deskOffset, need + 4)) * tf
    jA = math.max(0, jc - int(0.10 * S / U))
    jB = math.min(NK - 1, jc + int(0.10 * S / U))
    // coarse profile, at least ±5 %: regime, gamma flip, turning points and the card
    glo = math.min(dLo, S * 0.95)
    ghi = math.max(dHi, S * 1.05)
    gn  = 61
    st  = (ghi - glo) / (gn - 1)
    G = array.new<float>(gn, 0.0)
    for i = 0 to gn - 1
        G.set(i, totalGamma(glo + i * st, now, jA, jB))
    H = array.new<float>(gn, 0.0)
    i0 = int(math.round((S - glo) / st))
    for i = i0 + 1 to gn - 1
        H.set(i, H.get(i - 1) - 0.5 * (G.get(i) + G.get(i - 1)) * st)
    for i = i0 - 1 to 0
        H.set(i, H.get(i + 1) + 0.5 * (G.get(i) + G.get(i + 1)) * st)
    float flip = na
    for dd = 1 to gn
        for sg in array.from(1, -1)
            ii = i0 + sg * dd
            if na(flip) and ii >= 0 and ii < gn and math.sign(G.get(ii)) != math.sign(G.get(i0))
                flip := glo + ii * st
    if showFlip and not na(flip)
        lines.push(line.new(bar_index - 60, flip, bar_index + 20, flip, color = flipCol, width = 1, style = line.style_dotted))
        labels.push(label.new(bar_index + 20, flip, "Gamma flip " + fmtPx(flip), style = label.style_label_left, color = color.new(flipCol, 85), textcolor = flipCol, size = size.small))
    gS  = totalGamma(S, now, jA, jB)
    reg = gS > 0
    float turnDn = na
    float turnUp = na
    for i = i0 - 1 to 0
        if na(turnDn) and (G.get(i) > 0) != reg
            turnDn := glo + i * st
    for i = i0 + 1 to gn - 1
        if na(turnUp) and (G.get(i) > 0) != reg
            turnUp := glo + i * st
    regCol = reg ? colDamp : colAmp
    // fine profile over exactly the desk range (hedge integrated from the current price)
    dn  = 41
    dst = (dHi - dLo) / (dn - 1)
    DG = array.new<float>(dn, 0.0)
    for i = 0 to dn - 1
        DG.set(i, totalGamma(dLo + i * dst, now, jA, jB))
    DH = array.new<float>(dn, 0.0)
    iu = math.min(dn - 1, math.max(1, int(math.floor((S - dLo) / dst)) + 1))
    DH.set(iu, -0.5 * (gS + DG.get(iu)) * (dLo + iu * dst - S))
    if iu < dn - 1
        for i = iu + 1 to dn - 1
            DH.set(i, DH.get(i - 1) - 0.5 * (DG.get(i) + DG.get(i - 1)) * dst)
    DH.set(iu - 1, 0.5 * (gS + DG.get(iu - 1)) * (S - (dLo + (iu - 1) * dst)))
    if iu >= 2
        for i = iu - 2 to 0
            DH.set(i, DH.get(i + 1) + 0.5 * (DG.get(i) + DG.get(i + 1)) * dst)
    float mx = 1e-12
    for i = 0 to dn - 1
        mx := math.max(mx, math.abs(DH.get(i)))
    lsz = deskText == "Tiny" ? size.tiny : deskText == "Normal" ? size.normal : size.small
    // panel layout (right to left): axis tR | wedge (wBars) | number column (cBars)
    cBars = int(math.max(8, wBars * 1.1))
    xW = tR - wBars * tf                        // left edge of the wedge area
    xC = xW - tf                                // numbers are right-aligned here
    xP = xC - cBars * tf                        // left edge of the panel
    if showDesk
        if showTint
            boxes.push(box.new(xP, dHi, tR + 2 * tf, dLo, xloc = xloc.bar_time, border_color = color.new(regCol, 70), border_width = 1, bgcolor = color.new(colPanel, 12)))
            boxes.push(box.new(xW, dHi, tR, dLo, xloc = xloc.bar_time, border_color = color.new(regCol, 100), bgcolor = color.new(regCol, 94)))
        // header and footer
        labels.push(label.new(xP, dHi, "  DEALER HEDGE   " + (reg ? "● dampening" : "● amplifying") + "  ", xloc = xloc.bar_time, style = label.style_label_upper_left, color = color.new(colPanel, 100), textcolor = regCol, size = lsz))
        labels.push(label.new(xP, dLo, "  what dealers trade if price goes there · 100 = most on screen  ", xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(colPanel, 100), textcolor = color.new(colText, 55), size = size.tiny))
        // axis and the current price
        lines.push(line.new(tR, dLo, tR, dHi, xloc = xloc.bar_time, color = color.new(colText, 65), width = 1))
        lines.push(line.new(xW, S, tR, S, xloc = xloc.bar_time, color = color.new(colText, 40), width = 1, style = line.style_dashed))
        labels.push(label.new(tR, S, "  " + fmtPx(S) + "  ", xloc = xloc.bar_time, style = label.style_label_left, color = colText, textcolor = #0b0f14, size = size.tiny))
        // wedge: filled runs of the same colour (buy below / sell above / amplify) with a sharp edge
        rs = 0
        for j = 0 to dn - 2
            cd = DG.get(j) + DG.get(j + 1) < 0 ? 2 : dLo + (j + 0.5) * dst < S ? 0 : 1
            nx = j + 1 <= dn - 2 ? (DG.get(j + 1) + DG.get(j + 2) < 0 ? 2 : dLo + (j + 1.5) * dst < S ? 0 : 1) : -1
            if nx != cd
                c = cd == 0 ? colDamp : cd == 1 ? colDampUp : colAmp
                poly = array.new<chart.point>()
                edge = array.new<chart.point>()
                poly.push(chart.point.from_time(tR, dLo + rs * dst))
                for mm = rs to j + 1
                    pt = chart.point.from_time(xAt(DH.get(mm), tR, mx, wBars, tf), dLo + mm * dst)
                    poly.push(pt)
                    edge.push(pt)
                poly.push(chart.point.from_time(tR, dLo + (j + 1) * dst))
                polys.push(polyline.new(poly, false, true, xloc.bar_time, color.new(c, 100), color.new(c, wedgeFill)))
                polys.push(polyline.new(edge, false, false, xloc.bar_time, color.new(c, 0), line_width = 2))
                rs := j + 1
        // one row in the number column: price · action strength, with a leader line to the wedge edge
        taken = array.new<float>()
        minGap = (dHi - dLo) / (ladderN * 1.4)
        if showPct
            for f in array.from(0.99, 1.01)
                p = S * f
                if p > dLo and p < dHi
                    v = hAt(DH, dLo, dst, p)
                    if not na(v)
                        c = v >= 0 ? colDamp : colDampUp
                        lines.push(line.new(xC, p, xAt(v, tR, mx, wBars, tf), p, xloc = xloc.bar_time, color = color.new(c, 30), width = 1))
                        labels.push(label.new(xC, p, (f < 1 ? "−1 %  " : "+1 %  ") + fmtPx(p) + "   " + str.upper(buySell(v)) + " " + str.tostring(rel(v, mx)), xloc = xloc.bar_time, style = label.style_label_right, color = color.new(c, 75), textcolor = c, size = lsz))
                        taken.push(p)
        if showTurns
            for p in array.from(turnDn, turnUp)
                if not na(p) and p > dLo and p < dHi
                    lines.push(line.new(xC, p, tR, p, xloc = xloc.bar_time, color = color.new(colAmp, 35), width = 1, style = line.style_dashed))
                    labels.push(label.new(xC, p, "TURNS  " + fmtPx(p), xloc = xloc.bar_time, style = label.style_label_right, color = color.new(colAmp, 75), textcolor = colAmp, size = lsz, tooltip = reg ? "Past " + fmtPx(p) + " dealers stop dampening and start amplifying the move." : "Past " + fmtPx(p) + " dealers switch back to dampening the move."))
                    taken.push(p)
        if showLadder
            stp = niceStep((dHi - dLo) / ladderN)
            for pp = math.ceil(dLo / stp) * stp to dHi by stp
                v = hAt(DH, dLo, dst, pp)
                bool free = math.abs(pp - S) > minGap * 0.5 and pp < dHi - (dHi - dLo) * 0.07 and pp > dLo + (dHi - dLo) * 0.05
                for q in taken
                    if math.abs(pp - q) < minGap
                        free := false
                if not na(v) and free
                    c = v >= 0 ? colDamp : colDampUp
                    r = rel(v, mx)
                    lines.push(line.new(xC, pp, xAt(v, tR, mx, wBars, tf), pp, xloc = xloc.bar_time, color = color.new(c, 75), width = 1, style = line.style_dotted))
                    labels.push(label.new(xC, pp, fmtPx(pp) + "   " + (r == 0 ? "± 0" : str.upper(buySell(v)) + " " + str.tostring(r)), xloc = xloc.bar_time, style = label.style_label_right, color = color.new(colPanel, 100), textcolor = color.new(c, r >= 50 ? 0 : 25), size = lsz, tooltip = "If price goes to " + fmtPx(pp) + ", dealers must " + buySell(v) + " to stay hedged. Strength " + str.tostring(r) + " of 100 (100 = the most within the visible range)."))
    if showCard
        if cards.size() > 0
            table.delete(cards.pop())
        tsz = cardSize == "Tiny" ? size.tiny : cardSize == "Normal" ? size.normal : size.small
        t = table.new(cardPosition(), 2, 8, bgcolor = colPanel, frame_color = color.new(regCol, 55), frame_width = 1, border_width = 0)
        cards.push(t)
        dn1 = hAt(H, glo, st, S * 0.99)
        up1 = hAt(H, glo, st, S * 1.01)
        float mxC = 1e-12
        for i = 0 to gn - 1
            if math.abs(glo + i * st - S) <= S * 0.025
                mxC := math.max(mxC, math.abs(H.get(i)))
        table.cell(t, 0, 0, reg ? "● Dealers dampen moves" : "● Dealers amplify moves", text_color = regCol, text_size = tsz, text_halign = text.align_left, text_font_family = font.family_monospace)
        table.cell(t, 1, 0, (reg ? "LONG" : "SHORT") + " GAMMA · simulated", text_color = color.new(colText, 60), text_size = size.tiny, text_halign = text.align_right, text_font_family = font.family_monospace)
        rows = array.new<string>()
        cols = array.new<color>()
        rows.push("Falls 1 %: dealers " + buySell(nz(dn1)) + " (" + str.tostring(rel(nz(dn1), mxC)) + "). Rises 1 %: dealers " + buySell(nz(up1)) + " (" + str.tostring(rel(nz(up1), mxC)) + ").")
        cols.push(color.new(colText, 12))
        if not na(turnDn)
            rows.push("Below " + fmtPx(turnDn) + (reg ? " they start to amplify drops." : " they start to dampen again."))
            cols.push(reg ? colAmp : colDamp)
        if not na(turnUp)
            rows.push("Above " + fmtPx(turnUp) + (reg ? " they start to amplify rallies." : " they start to dampen again."))
            cols.push(reg ? colAmp : colDamp)
        float nxt = na
        for s = 0 to NS - 1
            e = SE.get(s)
            if not na(e) and e > now and (na(nxt) or e < nxt)
                nxt := e
        if not na(nxt)
            secs = (nxt - now) / 1000
            rows.push("Next expiry " + str.upper(str.format_time(int(nxt), "d MMM HH:mm", "UTC")) + " UTC · in " + (secs < 48 * 3600 ? str.tostring(math.round(secs / 3600)) + " h" : str.tostring(math.round(secs / 86400)) + " d"))
            cols.push(color.new(#ffb300, 0))
        rows.push("Volatility " + str.tostring(IV * 100, "0.0") + " % (" + IV_SRC + ") · " + (IS_CRYPTO ? "crypto" : IDX_DAILY ? "US index" : "US/other") + " calendar · simulated from price, volume and calendar")
        cols.push(color.new(colText, 55))
        for r = 0 to rows.size() - 1
            table.cell(t, 0, r + 1, rows.get(r), text_color = cols.get(r), text_size = r == rows.size() - 1 ? size.tiny : tsz, text_halign = text.align_left, text_font_family = font.family_monospace)
            table.merge_cells(t, 0, r + 1, 1, r + 1)
