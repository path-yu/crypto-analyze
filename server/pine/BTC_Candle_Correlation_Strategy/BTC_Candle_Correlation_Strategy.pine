//@version=6
// ============================================================================
// BTC Candle Correlation Strategy —— v6 迁移版
//
// 迁移自同目录同名的 v4 版本。语法迁移：security() → request.security()、
//   ta.* / math.* / str.* 前缀、input.* 构造器、逗号连写声明拆分为独立行、
//   strategy() 位置参数 + default_qty_type/value 必填项。
//
// 【已知限制】原脚本用 7 家交易所（BITFINEX / POLONIEX / BITSTAMP / COINBASE /
// BITMEX / KRAKEN / BINANCE）的 BTC 报价求「平均 K 线」，本项目是**单标的**
// 回测引擎，无法同时加载 7 个行情源，因此 src* 全部回落到当前标的，
// 「平均 K 线」退化为当前 K 线（与旧编译器对多标的的回落行为一致）。
// 策略结构本身（Keltner 通道双向突破 + 时间窗过滤）保持原样。
//
// 【为什么加 margin_long=0 / margin_short=0】本脚本按「100% 权益」定仓位
// （default_qty_type=strategy.percent_of_equity, default_qty_value=100），
// 名义价值恒等于权益，PineTS 券商模拟器会在成交当根就触发 Margin call，
// 账本里因此掺入与真实成交同 bar 的微型残单（实测 98 笔里有 49 笔是残单）。
// 关掉保证金强平后账本干净（98→55，与旧编译器逐笔一致）。
// ============================================================================
strategy("BTC Candle Correlation Strategy", overlay=true, initial_capital=100000,
  default_qty_type=strategy.percent_of_equity, default_qty_value=100,
  commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=1,
  margin_long=0, margin_short=0)

//sources for average
// 单标的回退：本项目回测引擎一次只加载一个标的，PineTS 的 request.security 对
// 非当前标的会返回 na（而导致整条链路全 na、信号永远不成立）。这里让 7 家交易所
// 的报价全部回落到当前标的 —— 与原 v4 版本在本项目旧编译器里的「多标的不支持，
// 回落到当前序列」行为一致，于是「平均 K 线」退化为当前 K 线。
src_c = close
src_h = high
src_l = low
src_o = open

//declaring variables
candle_open = src_o
candle_high = src_h
candle_low = src_l
candle_close = src_c

//////////////////////////////////////////////////////////
// high^2 / 2 - low^2 -2
h = math.pow(candle_high, 2) / 2
l = math.pow(candle_low, 2) / 2

o = math.pow(candle_open, 2) / 2
c = math.pow(candle_close, 2) / 2

x = (h + l + o + c) / 4
y = math.sqrt(x)

source = y
useTrueRange = false
length = input.int(9, minval=1)
mult = input.float(0.9, step=0.1)
ma = ta.sma(source, length)
rangeVal = useTrueRange ? ta.tr : candle_high - candle_low
rangema = ta.sma(rangeVal, length)
upper = ma + rangema * mult
lower = ma - rangema * mult
crossUpper = ta.crossover(source, upper)
crossLower = ta.crossunder(source, lower)
bprice = 0.0
bprice := crossUpper ? candle_high : nz(bprice[1])
sprice = 0.0
sprice := crossLower ? candle_low : nz(sprice[1])
crossBcond = false
crossBcond := crossUpper ? true : nz(crossBcond[1]) ? false : crossBcond[1]
crossScond = false
crossScond := crossLower ? true : nz(crossScond[1]) ? false : crossScond[1]
cancelBcond = crossBcond and (source < ma or candle_high >= bprice)
cancelScond = crossScond and (source > ma or candle_low <= sprice)

longOnly = input.bool(true)

fromDay = input.int(1, "From Day", minval=1, maxval=31)
fromMonth = input.int(1, "From Month", minval=1, maxval=12)
fromYear = input.int(2000, "From Year", minval=1970)
// To Date Inputs
toDay = input.int(31, "To Day", minval=1, maxval=31)
toMonth = input.int(12, "To Month", minval=1, maxval=12)
toYear = input.int(2021, "To Year", minval=1970)

startDate = timestamp(fromYear, fromMonth, fromDay, 00, 00)
finishDate = timestamp(toYear, toMonth, toDay, 00, 00)
time_cond = time >= startDate and time <= finishDate

if (longOnly == false and time_cond)
    if (crossLower)
        strategy.cancel("long")
    if (crossUpper)
        strategy.entry("long", strategy.long)
    if (cancelScond)
        strategy.cancel("short")
    if (crossLower)
        strategy.entry("short", strategy.short)

if (longOnly and time_cond)
    if (crossLower)
        strategy.close("long")
    if (crossUpper and candle_close > candle_open)
        strategy.entry("long", strategy.long)
