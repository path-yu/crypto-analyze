//@version=6
// ============================================================================
// BTC_Long_Only_TV01_opt（做多策略Ai优化1） —— v6 迁移版
//
// 迁移自同目录同名的 v4 版本。仅做 v4 → v6 的语法迁移：
//   strategy() 位置参数 + default_qty_type/value 必填项、ta.* / str.* 前缀、
//   input.float() 构造器、`:=` 首次赋值改为 `=`。策略逻辑、参数默认值与口径不变。
//
// 与原脚本的唯一差别集中在「风险管理层」，入场条件、EMA20/SMA100/SMA200、
// MACD(12,26,7)、ATR(14) 的口径完全保持一致：
//
//   ① 保本止损（默认开启）：浮盈达到 1×ATR% 后，把止损上移到开仓价。
//   ② 死叉离场保留原样（默认 useCrossExit=1）。
//
// 被验证后否决的两项改动（本文件里已关闭，保留开关便于复现）：
//   · ATR 移动止损（trailAtrMult，默认 0）
//   · 修正 IsRising 的反向逻辑（useTrendFilter=1，默认 0）
//
// 已知口径说明：本项目撮合引擎对 Pine 脚本采用「信号 bar 收盘判定、下一根
// 开盘市价成交」，止损不会被盘中触发，实际成交可能差于设定值。
// ============================================================================
strategy("BTC_Long_Only_TV01_opt", overlay=true, max_bars_back=3000, initial_capital=100000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.1)

[macdLine, macdSignalLine, macdHist] = ta.macd(close, 12, 26, 7)

leverage = 1
positionSize = 1000.0

// --- 风险管理层参数（默认值 = 复盘结论推荐值）---
stopLossPct    = input.float(5.0, "StopLoss in %")
beAtrMult      = input.float(1.0, "BreakEven trigger (xATR%) 0=off")
trailAtrMult   = input.float(0.0, "Trailing stop (xATR%) 0=off")
trailAfterBE   = input.float(1.0, "Trail only after BreakEven armed (1/0)")
useCrossExit   = input.float(1.0, "Cross exit: 0=off 1=always 2=only-if-losing")
useTrendFilter = input.float(0.0, "True-rising momentum filter (1/0)")

FromDay   = 01
FromMonth = 01
FromYear  = 2020
ToDay     = 14
ToMonth   = 05
ToYear    = 2029

start  = timestamp(FromYear, FromMonth, FromDay, 00, 00)
finish = timestamp(ToYear, ToMonth, ToDay, 23, 59)
window() => time >= start and time <= finish

// --- 原始函数（名字与实现相反，见文件头说明；保持原样以复现原策略）---
IsRising(data, loopBack) =>
    bIsRising = true
    for n = 1 to loopBack
        if data[n] > data[n-1]
            bIsRising := false
        continue
    bIsRising

// --- 状态变量 ---
currentPrice = close
entryPrice = 0.0
stopLossPrice = 0.0
highestCloseSinceEntry = 0.0
bPositionOpened = false
bBreakEvenArmed = false
atrValue = 0.0
atrPct = 0.0

// --- 指标（与原脚本一致）---
ema     = ta.ema(close, 20)
sma     = ta.sma(close, 100)
smaSlow = ta.sma(close, 200)

plot(sma, color=color.green)
plot(smaSlow, color=color.orange)
plot(ema, color=color.yellow)

// --- 上一根状态结转 ---
stopLossPrice := na(stopLossPrice[1]) ? 0.0 : stopLossPrice[1]
entryPrice := na(entryPrice[1]) ? 0.0 : entryPrice[1]
highestCloseSinceEntry := na(highestCloseSinceEntry[1]) ? 0.0 : highestCloseSinceEntry[1]
bPositionOpened := na(bPositionOpened[1]) ? false : bPositionOpened[1]
bBreakEvenArmed := na(bBreakEvenArmed[1]) ? false : bBreakEvenArmed[1]

// --- 动量条件（原反向逻辑 / 修正版，可切换）---
bEMAIsRising      = IsRising(ema, 2)
bSMAIsRising      = IsRising(sma, 3)
bMACDIsRising     = IsRising(macdLine, 3)
bMACDHistIsRising = IsRising(macdHist, 1)
bSMASlowIsRising  = IsRising(smaSlow, 10)
bMACDSignalIsRising = IsRising(macdSignalLine, 3)

bEMAIsRisingTrue     = ema[0] > ema[2]
bSMAIsRisingTrue     = sma[0] > sma[3]
bMACDIsRisingTrue    = macdLine[0] > macdLine[3]
bSMASlowIsRisingTrue = smaSlow[0] > smaSlow[10]

bMomentumOriginal = bSMASlowIsRising and bMACDIsRising and bEMAIsRising and bSMAIsRising
bMomentumTrueRise = bSMASlowIsRisingTrue and bMACDIsRisingTrue and bEMAIsRisingTrue and bSMAIsRisingTrue
bMomentumUse = useTrendFilter >= 0.5 ? bMomentumTrueRise : bMomentumOriginal

atrValue := ta.atr(14)
atrPct := (atrValue / currentPrice) * 100

if (window())
    // ---- 开仓：条件与原脚本一致 ----
    if (bPositionOpened == false and bMomentumUse == true and ema[0] > sma[0] and sma[0] < currentPrice)
        stockPositionSize = (positionSize * leverage) / currentPrice
        entryPrice := currentPrice
        stopLossPrice := currentPrice * (1 - stopLossPct / 100)
        highestCloseSinceEntry := currentPrice
        bBreakEvenArmed := false
        bPositionOpened := true
        strategy.entry("myPosition", strategy.long, qty=stockPositionSize, comment="BUY at " + str.tostring(currentPrice))

    // ---- 持仓管理：保本（+ 可选移动止损）----
    if (bPositionOpened == true)
        highestCloseSinceEntry := math.max(highestCloseSinceEntry, currentPrice)
        if (beAtrMult > 0 and bBreakEvenArmed == false and currentPrice >= entryPrice * (1 + beAtrMult * atrPct / 100))
            bBreakEvenArmed := true
        if (trailAtrMult > 0)
            stopLossPrice := math.max(stopLossPrice, highestCloseSinceEntry * (1 - trailAtrMult * atrPct / 100))
        if (bBreakEvenArmed == true)
            stopLossPrice := math.max(stopLossPrice, entryPrice)

    // ---- 离场：硬止损 / 保本止损 ----
    if (bPositionOpened == true and currentPrice <= stopLossPrice)
        strategy.close("myPosition", comment="STOP " + str.tostring(currentPrice))
        bPositionOpened := false
        entryPrice := 0.0
        stopLossPrice := 0.0
        bBreakEvenArmed := false
        highestCloseSinceEntry := 0.0

    // ---- 离场：EMA/SMA 死叉（默认仅在浮亏时生效）----
    //   useCrossExit = 1：任何死叉都离场（原脚本行为，用于对照复现）
    //   useCrossExit = 2：仅浮亏时按死叉离场（推荐）
    if (bPositionOpened == true and useCrossExit > 0.5 and useCrossExit < 1.5 and ta.crossunder(ema[1], sma[1]))
        strategy.close("myPosition", comment="CROSS " + str.tostring(currentPrice))
        bPositionOpened := false
        entryPrice := 0.0
        stopLossPrice := 0.0
        bBreakEvenArmed := false
        highestCloseSinceEntry := 0.0

    if (bPositionOpened == true and useCrossExit >= 1.5 and currentPrice <= entryPrice and ta.crossunder(ema[1], sma[1]))
        strategy.close("myPosition", comment="CROSS-LOSS " + str.tostring(currentPrice))
        bPositionOpened := false
        entryPrice := 0.0
        stopLossPrice := 0.0
        bBreakEvenArmed := false
        highestCloseSinceEntry := 0.0
