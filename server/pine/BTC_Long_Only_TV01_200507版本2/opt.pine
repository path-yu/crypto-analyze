//@version=4
// ============================================================================
// BTC_Long_Only 复盘优化版（参数化）
//
// 与原始脚本 (BTC_Long_Only_TV01_200507版本2.pine) 的唯一区别是「风险管理层」：
//   入场条件、EMA20/SMA100/SMA200、MACD、ATR 口径完全保持一致，
//   通过 4 个 input 开关独立增补 / 替换离场逻辑，便于逐项归因。
//
// 参数默认值 = 全部关闭 ⇒ 行为与原始脚本一致（用于基线校验）。
//   stopLossPct    初始硬止损（与原脚本一致，默认 5%）
//   beAtrMult      浮盈达到 N×ATR% 后把止损上移到成本价（0 = 关闭）
//   trailAtrMult   自持仓期最高收盘价回撤 N×ATR% 的移动止损（0 = 关闭）
//   useCrossExit   是否保留原始「EMA/SMA 死叉」离场（1 = 保留，0 = 关闭）
//   useTrendFilter 是否用「真实上升」修正原 IsRising 的反向逻辑（1 = 修正）
// ============================================================================
strategy(title="BTC_Long_Only_TV01_opt", overlay=true, max_bars_back=3000, initial_capital=1000, commission_value=0.1)

[macdLine, macdSignalLine, macdHist] = macd(close, 12, 26, 7)

leverage = 1
positionSize = 1000

float stopLossPct    = input(5.0, "StopLoss in %", type=input.float)
float beAtrMult      = input(0.0, "BreakEven trigger (xATR%) 0=off", type=input.float)
float trailAtrMult   = input(0.0, "Trailing stop (xATR%) 0=off", type=input.float)
float trailAfterBE   = input(1.0, "Trail only after BreakEven armed (1/0)", type=input.float)
float useCrossExit   = input(1.0, "Cross exit: 0=off 1=always 2=only-if-losing", type=input.float)
float useTrendFilter = input(0.0, "True-rising momentum filter (1/0)", type=input.float)

FromDay   = 01
FromMonth = 01
FromYear  = 2020
ToDay     = 14
ToMonth   = 05
ToYear    = 2029

start  = timestamp(FromYear, FromMonth, FromDay, 00, 00)
finish = timestamp(ToYear, ToMonth, ToDay, 23, 59)
window() => time >= start and time <= finish

// --- 原始函数（注意：其逻辑是反向的，名字与实现不符，见复盘文档 §4.1）---
IsRising(data, loopBack) =>
    bIsRising = true
    for n = 1 to loopBack
        if data[n] > data[n-1]
            bIsRising := false
        continue
    bIsRising

// --- 状态变量 ---
float currentPrice = close
float entryPrice = 0.0
float stopLossPrice = 0.0
float highestCloseSinceEntry = 0.0
bool  bPositionOpened = false
bool  bBreakEvenArmed = false
float atrValue = 0.0
float atrPct = 0.0

// --- 指标（与原脚本一致）---
ema     = ema(close, 20)
sma     = sma(close, 100)
smaSlow = sma(close, 200)

plot(sma, color=color.green)
plot(smaSlow, color=color.orange)
plot(ema, color=color.yellow)

// --- 上一根状态结转 ---
stopLossPrice := na(stopLossPrice[1]) ? 0.0 : stopLossPrice[1]
entryPrice := na(entryPrice[1]) ? 0.0 : entryPrice[1]
highestCloseSinceEntry := na(highestCloseSinceEntry[1]) ? 0.0 : highestCloseSinceEntry[1]
bPositionOpened := na(bPositionOpened[1]) ? false : bPositionOpened[1]
bBreakEvenArmed := na(bBreakEvenArmed[1]) ? false : bBreakEvenArmed[1]

// --- 动量条件 ---
bEMAIsRising      := IsRising(ema, 2)
bSMAIsRising      := IsRising(sma, 3)
bMACDIsRising     := IsRising(macdLine, 3)
bMACDHistIsRising := IsRising(macdHist, 1)
bSMASlowIsRising  := IsRising(smaSlow, 10)
bMACDSignalIsRising = IsRising(macdSignalLine, 3)

// 修正版：窗口内净上升（data[0] > data[loopBack]），与原反向逻辑互为对照
bEMAIsRisingTrue   = ema[0] > ema[2]
bSMAIsRisingTrue   = sma[0] > sma[3]
bMACDIsRisingTrue  = macdLine[0] > macdLine[3]
bSMASlowIsRisingTrue = smaSlow[0] > smaSlow[10]

bMomentumOriginal = bSMASlowIsRising and bMACDIsRising and bEMAIsRising and bSMAIsRising
bMomentumTrueRise = bSMASlowIsRisingTrue and bMACDIsRisingTrue and bEMAIsRisingTrue and bSMAIsRisingTrue
bMomentumUse = useTrendFilter >= 0.5 ? bMomentumTrueRise : bMomentumOriginal

atrValue := atr(14)
atrPct := (atrValue / currentPrice) * 100

if (window())
    // ---- 开仓（条件与原脚本一致，仅动量分支可切换）----
    if (bPositionOpened == false and bMomentumUse == true and ema[0] > sma[0] and sma[0] < currentPrice)
        stockPositionSize = (positionSize*leverage)/currentPrice
        entryPrice := currentPrice
        stopLossPrice := currentPrice * (1 - stopLossPct/100)
        highestCloseSinceEntry := currentPrice
        bBreakEvenArmed := false
        bPositionOpened := true
        strategy.entry("myPosition", strategy.long, qty=stockPositionSize, comment="BUY at " + tostring(currentPrice))

    // ---- 持仓管理：保本 + 移动止损 ----
    if (bPositionOpened == true)
        highestCloseSinceEntry := math.max(highestCloseSinceEntry, currentPrice)
        if (beAtrMult > 0 and bBreakEvenArmed == false and currentPrice >= entryPrice * (1 + beAtrMult*atrPct/100))
            bBreakEvenArmed := true
        if (trailAtrMult > 0 and (trailAfterBE < 0.5 or bBreakEvenArmed == true))
            stopLossPrice := math.max(stopLossPrice, highestCloseSinceEntry * (1 - trailAtrMult*atrPct/100))
        if (bBreakEvenArmed == true)
            stopLossPrice := math.max(stopLossPrice, entryPrice)

    // ---- 离场：硬止损 ----
    if (bPositionOpened == true and currentPrice <= stopLossPrice)
        strategy.close("myPosition", comment="STOP " + tostring(currentPrice))
        bPositionOpened := false
        entryPrice := 0.0
        stopLossPrice := 0.0
        bBreakEvenArmed := false
        highestCloseSinceEntry := 0.0

    // ---- 离场：原始 EMA/SMA 死叉 ----
    //   mode 1：任何死叉都离场（原脚本行为）
    //   mode 2：仅当仓位处于浮亏时才按死叉离场 —— 把死叉当作「止损性质」的信号，
    //           盈利中的仓位交给保本 / 移动止损管理，避免在趋势中过早离场
    if (bPositionOpened == true and useCrossExit > 0.5 and useCrossExit < 1.5 and crossunder(ema[1], sma[1]))
        strategy.close("myPosition", comment="CROSS " + tostring(currentPrice))
        bPositionOpened := false
        entryPrice := 0.0
        stopLossPrice := 0.0
        bBreakEvenArmed := false
        highestCloseSinceEntry := 0.0

    if (bPositionOpened == true and useCrossExit >= 1.5 and currentPrice <= entryPrice and crossunder(ema[1], sma[1]))
        strategy.close("myPosition", comment="CROSS-LOSS " + tostring(currentPrice))
        bPositionOpened := false
        entryPrice := 0.0
        stopLossPrice := 0.0
        bBreakEvenArmed := false
        highestCloseSinceEntry := 0.0
