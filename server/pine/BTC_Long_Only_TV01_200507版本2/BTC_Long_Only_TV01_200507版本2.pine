//@version=6
// ============================================================================
// BTC_Long_Only_TV01_200507（200507 版本2） —— v6 迁移版
//
// 迁移自同目录同名的 v4 版本。仅做 v4 → v6 的语法迁移：
//   strategy() 位置参数 + default_qty_type/value 必填项、ta.* / str.* 前缀、
//   input.float() 构造器。策略逻辑、参数默认值、窗口与仓位口径完全不变。
//
// 与 200507 原版的唯一差别：入场**没有** ATR% < 2 的波动过滤，止损默认 5%。
// ============================================================================
strategy("BTC_Long_Only_TV01_200507", overlay=true, max_bars_back=3000, initial_capital=100000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.1)

[macdLine, macdSignalLine, macdHist] = ta.macd(close, 12, 26, 7)

_rsi_len = 14

NewValue = 0
PreviousValue = 0
leverage = 1

smaPercentageIncrease = 0.0
SMA_PERCENT_INCREASE = 0.0
atrValue = 0.0
bPositionOpened = false
stockPositionSize = 0.0
volatilityPercentage = 0.0
bDisplayArrow = false
bEMAIsRising = false
bSMAIsRising = false
bSMASlowIsRising = false
bMACDIsRising = false
bMACDHistIsRising = false
bMACDSignalIsRising = false

stopLoss = input.float(5.0, "StopLoss in %")
positionSize = 1000.0
currentPrice = close
stopLossPrice = 0.0
entryPrice = 0.0

FromDay   = 01
FromMonth = 01
FromYear  = 2020
ToDay     = 14
ToMonth   = 05
ToYear    = 2029

start     = timestamp(FromYear, FromMonth, FromDay, 00, 00)
finish    = timestamp(ToYear, ToMonth, ToDay, 23, 59)
window()  => time >= start and time <= finish

//FUNCTION DEFINITIONS
IsRising(data, loopBack) =>
    bIsRising = true
    for n = 1 to loopBack
        if data[n] > data[n-1]
            bIsRising := false
        continue
    bIsRising

IsFalling(data, loopBack) =>
    bIsFalling = true
    for n = 1 to loopBack
        if data[n] < data[n-1]
            bIsFalling := false
        continue
    bIsFalling
// END OF FUNCTION DEFINITIONS //

emaLength = 20
smaLength = 100
smaSlowLength = 200

ema = ta.ema(close, emaLength)
sma = ta.sma(close, smaLength)
smaSlow = ta.sma(close, smaSlowLength)

plot(sma, color=color.green)
plot(smaSlow, color=color.orange)
plot(ema, color=color.yellow)

//reload previous values
stopLossPrice := na(stopLossPrice[1]) ? 0.0 : stopLossPrice[1]
entryPrice := na(entryPrice[1]) ? 0.0 : entryPrice[1]
bPositionOpened := na(bPositionOpened[1]) ? false : bPositionOpened[1]
positionSize := na(positionSize[1]) ? 1000.0 : positionSize[1]
stockPositionSize := na(stockPositionSize[1]) ? 0.0 : stockPositionSize[1]

bEMAIsRising := IsRising(ema, 2)
bSMAIsRising := IsRising(sma, 3)
bMACDIsRising := IsRising(macdLine, 3)
bMACDHistIsRising := IsRising(macdHist, 1)
bSMASlowIsRising := IsRising(smaSlow, 10)
bMACDSignalIsRising := IsRising(macdSignalLine, 3)

atrValue := ta.atr(14)
volatilityPercentage := (atrValue / currentPrice) * 100 //calcute the volatility. Percentage of the actual price

if (window())
    if (bPositionOpened == false and bSMASlowIsRising == true and bMACDIsRising == true and bEMAIsRising == true and bSMAIsRising == true and ema[0] > sma[0] and sma[0] < currentPrice)
        stockPositionSize := (positionSize * leverage) / currentPrice
        stopLossPrice := currentPrice * (1 - stopLoss / 100)
        strategy.entry("myPosition", strategy.long, qty=stockPositionSize, comment="BUY at " + str.tostring(currentPrice))
        entryPrice := currentPrice
        bPositionOpened := true
        bDisplayArrow := true

    if (bPositionOpened == true and (currentPrice <= stopLossPrice or ta.crossunder(ema[1], sma[1])))
        strategy.close("myPosition", comment="" + str.tostring(currentPrice)) //Stop
        bPositionOpened := false
        bDisplayArrow := true
        entryPrice := 0.0
