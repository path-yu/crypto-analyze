//@version=6
// ============================================================================
//  Altcoin Short Strategy  |  加密货币山寨币做空策略
//  Pine Script v6  |  TradingView strategy
//
//  逻辑概要:
//    趋势过滤:  EMA 空头排列 (EMA_fast < EMA_slow < EMA_trend) + 价格在长期均线下方
//    动量触发:  RSI 从超买区回落 + 跌破前期结构低点 (Donchian 下轨击穿)
//    风控:      ATR 动态止损 / 止盈 + 可选移动止损, 目标按 ATR 倍数设定
//    过滤:      波动率下限 (避免死水行情), 冷却期 (避免频繁重复入场)
//
//  注意: 本脚本为策略逻辑演示。加密货币为 7x24 交易, TradingView 回测已包含
//        手续费/滑点设定, 但无法建模资金费率、流动性枯竭、交易所插针等真实因素。
//        不构成任何投资建议。
// ============================================================================

strategy("Altcoin Short Strategy (v6)", overlay = true, 
     default_qty_type      = strategy.percent_of_equity, 
     default_qty_value     = 100, 
     initial_capital       = 10000, 
     pyramiding            = 0, 
     commission_type       = strategy.commission.percent, 
     commission_value      = 0.05, 
     slippage              = 5, 
     calc_on_every_tick    = false, 
     process_orders_on_close = false, 
     margin_long           = 100, 
     margin_short          = 100)

// ============================================================================
//  ── 输入参数 ──────────────────────────────────────────────────────────────
// ============================================================================

// ── 趋势组 ──
grpTrend = "① 趋势过滤 (Trend Filter)"
emaFastLen  = input.int(12,  "快线 EMA 周期",   minval = 2, group = grpTrend, tooltip = "短期指数均线, 用于捕捉短期动能方向")
emaSlowLen  = input.int(26,  "中线 EMA 周期",   minval = 3, group = grpTrend, tooltip = "中期指数均线, 与快线构成空头排列判断")
emaTrendLen = input.int(100, "慢线 EMA 周期",   minval = 10, group = grpTrend, tooltip = "长期趋势线, 价格需在其下方才允许做空")
useTrendFilter = input.bool(true, "启用长期趋势过滤", group = grpTrend, tooltip = "关闭后仅用快/中两线判断空头排列, 信号更多但噪音更大")

// ── 动量组 ──
grpMom = "② 动量触发 (Momentum Trigger)"
rsiLen       = input.int(14, "RSI 周期", minval = 2, group = grpMom)
rsiOverbought= input.int(70, "RSI 超买阈值", minval = 50, maxval = 100, group = grpMom, tooltip = "RSI 曾高于此值, 视为出现超买")
rsiFallLevel = input.int(55, "RSI 回落触发线", minval = 30, maxval = 90, group = grpMom, tooltip = "RSI 从超买区跌破此线, 视为动能转向")
rsiLookback  = input.int(10, "超买回溯窗口 (根)", minval = 1, group = grpMom, tooltip = "在过去 N 根 K 线内是否出现过超买")

// ── 结构破位组 ──
grpStruct = "③ 结构破位 (Structure Break)"
useDonchian     = input.bool(true, "启用前低破位确认", group = grpStruct)
donchianLen     = input.int(20, "Donchian 通道周期", minval = 2, group = grpStruct, tooltip = "跌破过去 N 根的最低点视为结构破位")
useVolumeFilter = input.bool(false, "启用成交量过滤", group = grpStruct)
volumeMaLen     = input.int(20, "成交量均线周期", minval = 2, group = grpStruct)
volumeMult      = input.float(1.2, "放量倍数", minval = 0.1, step = 0.1, group = grpStruct, tooltip = "当前成交量需高于均量的 N 倍")

// ── 风控组 ──
grpRisk = "④ 风控 (Risk Control)"
atrLen        = input.int(14, "ATR 周期", minval = 2, group = grpRisk)
atrStopMult   = input.float(2.0, "止损 ATR 倍数", minval = 0.5, step = 0.1, group = grpRisk, tooltip = "止损 = 开空价 + N × ATR (做空方向上方)")
atrProfitMult = input.float(3.0, "止盈 ATR 倍数", minval = 0.5, step = 0.1, group = grpRisk, tooltip = "止盈 = 开空价 - N × ATR (做空方向下方)")
useTrailing   = input.bool(true, "启用移动止损", group = grpRisk, tooltip = "价格向有利方向移动后, 止损跟随下移锁定利润")
trailStartMult= input.float(1.0, "移动止损启动 ATR 倍数", minval = 0.1, step = 0.1, group = grpRisk, tooltip = "浮盈达到 N × ATR 后激活移动止损")
trailOffsetMult=input.float(1.2, "移动止损回撤 ATR 倍数", minval = 0.1, step = 0.1, group = grpRisk, tooltip = "移动止损价 = 入场后最低价 + N × ATR")

// ── 环境过滤组 ──
grpFilter = "⑤ 环境过滤 (Regime Filter)"
useVolFloor  = input.bool(true, "启用最低波动率过滤", group = grpFilter, tooltip = "ATR/价格 低于阈值时不开仓, 避免死水行情")
minAtrPct    = input.float(1.0, "最低 ATR 占价格比例 (%)", minval = 0.0, step = 0.1, group = grpFilter)
cooldownBars = input.int(5, "信号冷却期 (根)", minval = 0, group = grpFilter, tooltip = "平仓后需等待 N 根 K 线才能再次开仓")
allowLong    = input.bool(false, "允许做多", group = grpFilter, tooltip = "默认关闭: 本策略只做空。开启后按镜像逻辑做多(山寨币做多风险极高, 不建议)")

// ── 时间过滤组 ──
grpTime = "⑥ 时间过滤 (Session)"
useTimeFilter = input.bool(false, "启用交易时段过滤", group = grpTime)
tradeSession  = input.session("0000-2400", "允许开仓时段", group = grpTime, tooltip = "加密货币 7x24, 默认全天; 若只想在特定时段交易可修改")

// ============================================================================
//  ── 指标计算 ──────────────────────────────────────────────────────────────
// ============================================================================
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)
rsi      = ta.rsi(close, rsiLen)
atr      = ta.atr(atrLen)

// Donchian 下轨: 过去 N 根的最低价 (不含当前根, 避免用当根 low 造成同根前瞻)
donchianLow = ta.lowest(low, donchianLen)[1]

// 成交量均线
volMa = ta.sma(volume, volumeMaLen)

// ATR 占价格比例 (百分比)
atrPct = atr / close * 100.0

// ============================================================================
//  ── 信号条件 ──────────────────────────────────────────────────────────────
// ============================================================================

// ① 空头排列: 快线 < 中线, 且 (可选) 价格与慢线同样处于下方
bearishStack = emaFast < emaSlow
trendOk      = useTrendFilter ? (close < emaTrend and emaSlow < emaTrend) : true

// ② 动量转向: 过去 N 根内出现超买, 且当前 RSI 已跌破回落线并继续走弱
hadOverbought  = ta.highest(rsi, rsiLookback) > rsiOverbought
rsiTurningDown = hadOverbought and rsi < rsiFallLevel and rsi < rsi[1]

// ③ 结构破位: 收盘价跌破前 N 根最低点
structureBreak = useDonchian ? close < donchianLow : true

// ④ 成交量过滤
volumeOk = useVolumeFilter ? volume > volMa * volumeMult : true

// ⑤ 波动率下限
volFloorOk = useVolFloor ? atrPct >= minAtrPct : true

// ⑥ 时间过滤
inSession = not useTimeFilter or not na(time(timeframe.period, tradeSession))

// 冷却期计时器: 平仓后需等待 cooldownBars 根 K 线才能再次开仓
var int barsSinceExit = 100000
if strategy.position_size == 0 and strategy.position_size[1] != 0
    barsSinceExit := 0            // 本根刚由持仓转为空仓, 重置计时
else if strategy.position_size == 0
    barsSinceExit += 1            // 空仓状态逐根累计
cooldownOk = barsSinceExit >= cooldownBars

// ── 最终开空条件 ──
shortEntryCond = bearishStack and trendOk and rsiTurningDown and structureBreak and volumeOk and volFloorOk and inSession and cooldownOk

// ── 平空(反手)条件: 多头排列 + RSI 从超卖回升 ──
bullishStack = emaFast > emaSlow
rsiRebound = rsi > 45 and rsi[1] <= 45 and ta.lowest(rsi, rsiLookback)[0] < 35
shortExitCond = bullishStack and (useTrendFilter ? close > emaTrend : true) and rsiRebound

// 做多镜像条件 (默认关闭)
longEntryCond = allowLong and bullishStack and (useTrendFilter ? close > emaTrend : true) and rsi > 55 and rsi[1] <= 55

// ============================================================================
//  ── 仓位与订单管理 ──────────────────────────────────────────────────────────
// ============================================================================

// 每次开仓使用的权益比例
equityPct = input.float(100, "单次开仓占权益比例 (%)", minval = 1, maxval = 100, group = "⑦ 仓位 (Position)", tooltip = "默认满仓做空; 建议实盘降低该值")

// 计算下单数量 (按当前权益比例换算成标的数量)
orderQty = (strategy.equity * equityPct / 100.0) / close

// ── 开空 ──
// 用 strategy.entry 挂单, 实际成交在下一根 K 线开盘; 止损止盈锚定真实成交均价
// (strategy.position_avg_price), 而不是信号根的收盘价, 避免成交价偏移。
if shortEntryCond and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = orderQty)

// ── 平空(反手信号) ──
if shortExitCond and strategy.position_size < 0
    strategy.close("Short", comment = "反手平空")

// ── 开多 (默认关闭) ──
if longEntryCond and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty = orderQty)

// ============================================================================
//  ── ATR 动态止损 / 止盈 / 移动止损 ──────────────────────────────────────────
//  说明:
//    strategy.entry 在信号根下单、下一根开盘成交。为了让止损止盈锚定真实成交价,
//    这里以 strategy.position_avg_price (真实入场均价) 为基准, 用当前 ATR 计算
//    止损 / 止盈的绝对价格, 每根 K 线随 ATR 动态更新。
//      止损价 = 入场均价 + N × ATR   (做空方向: 上方)
//      止盈价 = 入场均价 - N × ATR   (做空方向: 下方)
// ============================================================================

// 持仓期间维护 "入场后最低价", 用于移动止损
var float lowestSinceEntry = na

// 每次新开空时初始化最低价, 持仓期间持续更新
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    lowestSinceEntry := low
else if strategy.position_size < 0
    lowestSinceEntry := math.min(nz(lowestSinceEntry, low), low)
else
    lowestSinceEntry := na

if strategy.position_size < 0
    // 以真实入场均价为基准
    realEntry = strategy.position_avg_price

    // 止损 / 止盈的绝对价差 (price 单位), 随当前 ATR 更新
    stopDist   = atr * atrStopMult      // 做空: 上方止损距离
    profitDist = atr * atrProfitMult    // 做空: 下方止盈距离

    // 移动止损: 浮盈达到启动门槛后, 止损下移到 (持仓期最低价 + N*ATR)
    trailArmed     = useTrailing and (realEntry - lowestSinceEntry) >= atr * trailStartMult
    trailStopPrice = lowestSinceEntry + atr * trailOffsetMult

    // 止损价: 固定止损与移动止损取更靠下的那个 (离现价更近, 先触发)
    fixedStopPrice = realEntry + stopDist
    finalStopPrice = trailArmed ? math.min(fixedStopPrice, trailStopPrice) : fixedStopPrice

    // 使用绝对价格形式挂止损止盈 (stop/limit 接受 price 序列)
    strategy.exit("TP/SL", from_entry = "Short", stop = finalStopPrice, limit = realEntry - profitDist, comment_loss = "ATR止损", comment_profit = "ATR止盈")

// ============================================================================
//  ── 可视化 ──────────────────────────────────────────────────────────────────
// ============================================================================
plot(emaFast,  "EMA Fast",  color = color.new(color.orange, 0),  linewidth = 2)
plot(emaSlow,  "EMA Slow",  color = color.new(color.blue, 0),    linewidth = 2)
plot(emaTrend, "EMA Trend", color = color.new(color.purple, 0),  linewidth = 2)

// Donchian 下轨
plot(useDonchian ? donchianLow : na, "Donchian Low", color = color.new(color.gray, 40), style = plot.style_line)

// 信号标记
plotshape(shortEntryCond and strategy.position_size == 0, title = "做空信号", location = location.abovebar, style = shape.triangledown, size = size.small, color = color.new(color.red, 0), text = "SHORT", textcolor = color.white)
plotshape(shortExitCond and strategy.position_size < 0,  title = "平空信号", location = location.belowbar, style = shape.triangleup,   size = size.small, color = color.new(color.green, 0), text = "COVER", textcolor = color.white)

// RSI 背景提示
bgcolor(useVolFloor and not volFloorOk ? color.new(color.gray, 92) : na, title = "低波动区")

// ============================================================================
//  ── 信息面板 ────────────────────────────────────────────────────────────────
// ============================================================================
var table infoTable = table.new(position.top_right, 2, 8, border_width = 1, border_color = color.new(color.gray, 50))

if barstate.islast
    atrDisplay = str.tostring(atr, format.mintick)
    atrPctDisplay = str.tostring(atrPct, "#.##") + "%"
    posText = strategy.position_size < 0 ? "空单持有中" : (strategy.position_size > 0 ? "多单持有中" : "空仓")
    posColor = strategy.position_size < 0 ? color.red : (strategy.position_size > 0 ? color.green : color.gray)

    table.cell(infoTable, 0, 0, "状态",       text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 0, posText,      text_color = color.white, bgcolor = color.new(posColor, 30), text_size = size.small)
    table.cell(infoTable, 0, 1, "ATR",        text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 1, atrDisplay,   text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.small)
    table.cell(infoTable, 0, 2, "ATR%",       text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 2, atrPctDisplay,text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.small)
    table.cell(infoTable, 0, 3, "RSI",        text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 3, str.tostring(rsi, "#.##"), text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.small)
    table.cell(infoTable, 0, 4, "净盈亏",     text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 4, str.tostring(strategy.netprofit, "#.##"), text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.small)
    table.cell(infoTable, 0, 5, "胜率",       text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 5, str.tostring(strategy.wintrades / math.max(strategy.closedtrades, 1) * 100, "#.##") + "%", text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.small)
    table.cell(infoTable, 0, 6, "总交易",     text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 6, str.tostring(strategy.closedtrades), text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.small)
    table.cell(infoTable, 0, 7, "冷却剩余",   text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(infoTable, 1, 7, str.tostring(math.max(cooldownBars - barsSinceExit, 0)) + " 根", text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.small)

// ============================================================================
//  ── 告警 ────────────────────────────────────────────────────────────────────
// ============================================================================
alertcondition(shortEntryCond and strategy.position_size == 0, title = "做空信号", message = "山寨币做空信号触发: {{ticker}} @ {{close}}")
alertcondition(shortExitCond and strategy.position_size < 0,  title = "平空信号", message = "平空信号触发: {{ticker}} @ {{close}}")
