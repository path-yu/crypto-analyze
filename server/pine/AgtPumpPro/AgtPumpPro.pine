//@version=6
// ============================================================================
// AgtPumpPro —— 巨量 + 「有效突破」暴涨捕获 v2  · v6
//
// 【为什么重写】Q/USDT:USDT · 1h · 近 6 个月（2026-04-17 ~ 2026-10-17）复盘：
//   原版 AgtPump 在 Q 上 4 笔交易全亏：-15.4% / -12.0% / -12.1% / -25.4%，
//   账户 -64.9%。4 笔信号 bar 的共同点：
//     · 突破幅度只有 +2.4% ~ +6.8%（贴着前 50 根高点的小新高）
//     · 而该币 ATR%14 ≈ 2.7% ~ 3.5% —— 突破幅度不到 2 倍 ATR，属于噪声
//     · RSI14 80~89、距 MA20 +15%~22%，进场即喷发末端
//     · 之后 2~22 根内回落，12% 固定止损在剧烈波动里被跳空穿透 → 实际 -15%~-25%
//   同一套参数在 AGT / AKE / BANK 上：16 笔里 9 胜，AGT +228%、AKE +174%、
//   BANK +58% —— 盈利笔的突破幅度普遍 ≥ +7.4%，与 Q 的 2%~7% 完全分层。
//
// 【v2 的四处改动】
//   1. 有效突破：新增「突破幅度 ≥ brkMin%」（默认 7%）—— 贴前高的小新高不算突破；
//      Q 的 4 笔亏损信号里 3 笔正是突破幅度只有 2.4%~2.5% 的噪声新高
//   2. 仓位：名义默认 200（1000 本金 ≈ 20%），单笔最大亏损 ≈ 账户 2.4%
//   3. 离场：保留原版（12% 止损 / 吊灯 15% / 时间 120 根）—— 实测收紧会截断
//      AGT/AKE 的大波段（同一批信号 +228% → +59%）；保本 / 分批止盈改为可选（默认关）
//   4. 新增「趋势破位退出」：浮亏且收盘跌破 EMA200 → 直接退出（不等止损）
//
// 【入场】巨量 + 有效突破：
//   成交量 ≥ volMult × 96 根均量
//   收盘 > 前 brkLen 根最高价 × (1 + brkMin%)
//   近 6 根涨幅 ≥ impPct%
//
// 【离场】
//   · 初始止损：固定 slPct%（暴涨当下 ATR% 被撑大，不用 ATR 止损）
//   · 保本：浮盈达 bePct% → 止损抬到成本价
//   · 分批：浮盈达 tp1Pct% → 平一半（TradingView 口径 qty_percent）
//   · 吊灯：止损 = max(止损, 持仓最高价 × (1 − trailPct%))，可设激活门槛
//   · 趋势：浮亏且收盘跌破 EMA200 → 退出
//   · 时间：持仓 maxBars 根仍未盈利 → 退出
//   离场判定一律用「上一根收盘就已确定」的止损价，不用本根 high 设、本根 low 触发。
//
// 【仓位】固定名义价值 qty = notional / 价格（显式 qty 优先于界面仓位比例 × 杠杆）。
// ============================================================================
strategy("AgtPumpPro", overlay=true, max_bars_back=500, initial_capital=100000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.055)

// ---------------- 入场参数 ----------------
notional = input.float(200.0, "单笔名义价值 USDT")
volMult  = input.float(14.0,  "成交量 / 96均量 ≥")
brkLen   = input.int(50,      "突破 N 根新高")
brkMin   = input.float(7.0,   "突破幅度 ≥ % (0=关)")
impPct   = input.float(16.0,  "近6根涨幅 ≥ % (0=关)")

// ---------------- 离场参数 ----------------
// 组合依据（同尺寸 1000 名义、4 个品种实测）：
//   · 保本 6%：浮盈摸到 +6% 就把止损抬到成本 —— 瀑布最多回到 0，不会倒亏；
//     它只「保护」不「截断」，AGG 的大波段仍由吊灯吃完
//   · 吊灯保持松：+20% 才激活、回撤 15% —— 收紧到 8%/6% 会把 AGT 的波段砍掉
//     （同一批信号 +101.9% → +115.0% 但 AKE +174.6% → +85.8%，整体反而更差）
//   · 止损位通过 plot("STOP") 透传给引擎做**盘中止损**，瀑布按止损价成交
slPct    = input.float(12.0,  "初始止损 %")
bePct    = input.float(6.0,   "保本触发 % (0=关)")
tp1Pct   = input.float(0.0,   "分批止盈 % (0=关)")
trailArm = input.float(20.0,  "吊灯激活所需浮盈 % (0=关)")
trailPct = input.float(15.0,  "吊灯移动止损 %")
maxBars  = input.int(120,     "时间止损 K线数")

// ---------------- 指标 ----------------
volMa  = ta.sma(volume, 96)
volR   = volMa > 0 ? volume / volMa : 0
imp    = close / close[6] - 1
hiN    = ta.highest(high, brkLen)
ema200 = ta.ema(close, 200)
brkPct = hiN[1] > 0 ? (close / hiN[1] - 1) * 100 : 0

plot(ta.sma(close, 20), color=color.orange)
plot(ema200, color=color.green)

entryCond = volR >= volMult and brkPct >= brkMin and (impPct < 0.5 or imp >= impPct / 100)

// ---------------- 状态（必须用 var）----------------
var float stopPx  = 0.0
var float entryPx = 0.0
var float hiSince = 0.0
var bool  armed   = false
var bool  tp1Done = false
var float heldN   = 0.0

if (strategy.position_size <= 0)
    stopPx := 0.0
    entryPx := 0.0
    hiSince := 0.0
    armed := false
    tp1Done := false
    heldN := 0.0
else
    if (stopPx == 0)
        // 新成交那一根：按成交均价初始化止损（止损从下一根起生效）
        entryPx := strategy.position_avg_price
        stopPx := entryPx * (1 - slPct / 100)
        hiSince := high
        armed := false
        tp1Done := false
        heldN := 0.0
    else
        // 1) 先用「上一根收盘时已确定」的止损 / 止盈判定离场
        if (low <= stopPx)
            strategy.close("P", comment="STOP " + str.tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and tp1Pct > 0 and tp1Done == false and high >= entryPx * (1 + tp1Pct / 100))
            strategy.close("P", qty_percent=50, comment="TP1 " + str.tostring(close))
            tp1Done := true
        if (stopPx > 0 and heldN >= maxBars and close <= entryPx)
            strategy.close("P", comment="TIME " + str.tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and close < ema200 and close < entryPx)
            strategy.close("P", comment="TREND " + str.tostring(close))
            stopPx := 0.0

    // 2) 再用本根收盘信息更新止损，供下一根使用
    hiSince := math.max(hiSince, high)
    if (bePct > 0 and armed == false and high >= entryPx * (1 + bePct / 100))
        armed := true
    if (armed)
        stopPx := math.max(stopPx, entryPx)
    if (trailArm <= 0 or hiSince >= entryPx * (1 + trailArm / 100))
        stopPx := math.max(stopPx, hiSince * (1 - trailPct / 100))
    heldN := heldN + 1

// 开仓（引擎在下一根开盘成交）
if (strategy.position_size <= 0 and entryCond)
    strategy.entry("P", strategy.long, qty=notional / close, comment="PUMP " + str.tostring(close))

// 止损位输出：title 必须叫 STOP —— 适配器按这个名字把它接成引擎的盘中止损。
// 空仓时 stopPx = 0，画 na 表示「本根没有止损」。
plot(stopPx > 0 ? stopPx : na, title="STOP", color=color.red)
