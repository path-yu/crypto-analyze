//@version=6
// ============================================================================
// AgtDump —— AGT（山寨币）1h 「放量砸盘」做空  · v6
//
// 【复盘依据】AGT/USDT:USDT · 1h · 近一年，共 14 段「自 72 根最高 high 回落 ≥30%」的下跌段：
//   · 多数是**阴跌**（历时 48~87 根、阴线占比 49%~67%、单根最大跌幅 6%~15%）
//   · 少数是**砸盘**（历时 2~5 根、单根最大跌幅 13%~28%）
// 下跌【确认 bar】特征 vs 全样本（中位）：
//   · 成交量 / 96 根均量：**4.21× vs 0.57×**   ← 最强，和暴涨一样是「放量」驱动
//   · ATR%：6.95 vs 2.46
//   · **相对 50 根新低：+30.1% vs +7.9%** —— 确认时价格仍**远高于** 50 根低点
//   · 距 MA200：+21.0%，**空头排列 / MA50 下行的中位都是 0** —— 下跌从**高位**开始
// 三条反直觉结论：
//   1. **「破 N 根新低」区分度差**（S1 捕获 11/14，但 83 段误报、精度仅 12%）——
//      因为这个币的下跌是「先见顶、再阴跌」，破新低时已经跌掉 26%。
//   2. **均线空头排列 / MA50 下行完全没有区分度**（中位 = 0）—— 别用趋势结构做条件。
//   3. **唯一高精度的是「放量长阴」**：单根跌幅 ≥8% 且 量 ≥5×96均量 → 精度 27%（全表最高），
//      捕获 7/14 段，触发后**还能再跌 19.4%**、距底还有 29 根 —— 所以入场用它。
//
// 【入场】放量长阴（可选叠加破位）
//   close < open            阴线
//   单根跌幅 ≤ −revPct%      默认 8%
//   成交量 ≥ volMult × SMA(成交量,96)   默认 5×
//   （可选）收盘 < 前 brkLen 根最低
//
// 【离场】（做空：止损在**上方**）
//   · 初始止损：entryPx × (1 + slPct%)，固定百分比（不用 ATR —— 砸盘当下 ATR% 被撑到 7%+）。
//   · 吊灯移动止损：止损 = min(止损, 持仓最低价 × (1 + trailPct%))，
//     可设「浮盈满 trailArm% 才激活」。
//   · 时间止损：持仓 maxBars 根仍未盈利 → 退出。
//   · 离场用「上一根收盘就已确定的止损」判定，绝不用本根 low 设止损、再用本根 high 触发。
//
// 【仓位】固定名义价值 qty = notional / 价格（TradingView 口径）。
// ============================================================================
strategy("AgtDump", overlay=true, max_bars_back=500, initial_capital=100000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.055)

// ---------------- 入场参数 ----------------
notional = input.float(1000.0, "单笔名义价值 USDT")
revPct   = input.float(8.0,  "单根跌幅 ≥ %")
volMult  = input.float(5.0,  "成交量 / 96均量 ≥")
minExt   = input.float(0.0,  "距MA20 ≥ % (0=关)")
brkLen   = input.int(0,     "破 N 根新低 (0=关)")

// ---------------- 离场参数 ----------------
slPct    = input.float(10.0, "初始止损 %")
tpPct    = input.float(0.0,  "止盈 % (0=关)")
trailArm = input.float(15.0, "移动止损激活所需浮盈 % (0=立即)")
trailPct = input.float(15.0, "吊灯移动止损 %")
maxBars  = input.float(96.0, "时间止损 K线数")

// ---------------- 指标 ----------------
volMa = ta.sma(volume, 96)
volR  = volMa > 0 ? volume / volMa : 0
barChg = close / close[1] - 1
ma20  = ta.sma(close, 20)
dist20 = ma20 > 0 ? close / ma20 - 1 : 0
loN   = ta.lowest(low, brkLen)
brk   = brkLen > 0 and close < loN[1]

plot(ma20, color=color.orange)
plot(ta.sma(close, 50), color=color.green)

entryCond = close < open and barChg <= -revPct / 100 and volR >= volMult and (minExt <= 0 or dist20 >= minExt / 100) and (brkLen <= 0 or brk)

// ---------------- 状态（必须用 var：顶层不带 var 是每根 bar 重新初始化）----------------
var float stopPx  = 0.0
var float entryPx = 0.0
var float loSince = 0.0
var float heldN   = 0.0

if (strategy.position_size >= 0)
    // 无空头持仓（含空仓）→ 清状态
    stopPx := 0.0
    entryPx := 0.0
    loSince := 0.0
    heldN := 0.0
else
    if (stopPx == 0)
        // 新成交那一根：按成交均价初始化止损（止损从下一根起生效）
        entryPx := strategy.position_avg_price
        stopPx := entryPx * (1 + slPct / 100)
        loSince := low
        heldN := 0.0
    else
        // 1) 先用「上一根收盘时已确定」的止损 / 止盈判定离场
        //    同一根内可能同时触及两者 → 保守按先打止损处理
        if (high >= stopPx)
            strategy.close("S", comment="STOP " + str.tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and tpPct > 0 and low <= entryPx * (1 - tpPct / 100))
            strategy.close("S", comment="TP " + str.tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and heldN >= maxBars and close >= entryPx)
            strategy.close("S", comment="TIME " + str.tostring(close))
            stopPx := 0.0

    // 2) 再用本根收盘信息更新止损，供下一根使用
    loSince := math.min(loSince, low)
    if (trailArm <= 0 or loSince <= entryPx * (1 - trailArm / 100))
        stopPx := math.min(stopPx, loSince * (1 + trailPct / 100))
    heldN := heldN + 1

// 开空（引擎在下一根开盘成交）
if (strategy.position_size >= 0 and entryCond)
    strategy.entry("S", strategy.short, qty=notional / close, comment="DUMP " + str.tostring(close))
