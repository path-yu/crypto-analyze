//@version=4
// ============================================================================
// MainWave —— 主升浪做多（1h）
//
// 【与「暴涨脉冲」策略的本质区别（本轮复盘的核心发现）】
// 用 25% 回撤 zigzag + 历时 ≥240 根（10 天）切出 20 个币的 **57 波主升浪**
// （涨幅 +31%~+320%，历时 250~1800 根），再对比它们**启动确认 bar**与全样本基线：
//
//   特征                  启动确认bar中位   基线中位
//   成交量 / 96均量             3.72          0.699   ← 5.3 倍
//   相对 24 / 50 / 100 根新高   +0.008        -0.041 / -0.061 / -0.091
//   均线多头排列(MA20>MA50>MA200)  1.000        0.000   ← 几乎完全区分
//   MA50 上行(10根)             1.000        0.000   ← 几乎完全区分
//   距 MA200                   +11.6%        -1.6%
//   近 24 / 72 根涨幅           +11.9% / +12.1%  -0.4% / -1.0%
//   ATR% / 240均值              1.33          0.926
//   布林带宽                    11.98%        6.10%
//
// 规则 lift（精度/基线，基线 0.034%）：
//   破100根新高          lift **102**  覆盖 39/57    ← 最强
//   破50新高+量≥2+站上MA200 lift 97    覆盖 37/57
//   破24新高+MA50上行+量≥1.2 lift 87   覆盖 41/57
//   破50根新高            lift 79     覆盖 44/57
//   破24新高+量≥1.5+多头排列 lift 85  覆盖 22/57
//   「窄幅横盘」+破24新高  lift 56     覆盖 46/57
//
// **关键反差**：上一轮做「2~3 天暴涨脉冲」时，「突破 N 根新高」几乎没有区分度
// （暴涨币启动时还在下跌结构里）；而做「持续多日的主升浪」时，**突破 100 根新高
// 是所有特征里最强的（lift 102）**，因为主升浪本身就是一个"不断创出新高"的持续趋势。
// 这就是两类行情必须用两套特征的原因。
//
// 【策略】只做一件事：**在主升浪刚突破时上车，然后一路持有到趋势掉头**。
//   入场  收盘 > 前 100 根最高价（突破）
//         且 成交量 ≥ 2 × 96 根均量（放量）
//         且 收盘 > MA200（方向过滤：只在长期均线上方做多）
//   离场  初始止损 8% + 吊灯移动止损 25%（对齐 zigzag 的 25% 回撤阈值，让利润奔跑）
//         可选保本；可选时间止损（默认关 —— 主升浪要耐心持有，不设时间上限）
//   冷却  止损后 cooldown 根内不再入场，避免同一段假突破里反复进出
//   其余时间：条件不满足就不交易（"能不做就不做"）
//
// 【仓位】固定名义价值 qty = notional / 价格。
// ============================================================================
strategy(title="MainWave", overlay=true, max_bars_back=500, initial_capital=1000, commission_value=0.055)

float notional  = input(1000.0, "单笔名义价值 USDT", type=input.float)
// ★ 突破窗口是全篇最关键的参数：实测「越稀有越好」，且 20 天之后收敛
//   （真·验证集 22 币中位：4天 -56% → 10天 -28% → 20天 0% → 30~60天 0%，均值 +4~9%）
float brkLen    = input(720.0, "突破窗口（根，720=30天）", type=input.float)
float volMult   = input(1.5,  "成交量 / 96均量 ≥", type=input.float)
float useMA200  = input(1.0,  "要求收盘 > MA200 (1/0)", type=input.float)
float slPct     = input(12.0, "初始止损 %", type=input.float)
float useFailStop = input(0.0, "突破失败即离场(收盘跌回突破位) (1/0)", type=input.float)
float bePct     = input(0.0,  "保本触发 % (0=关)", type=input.float)
float trailPct  = input(25.0, "吊灯移动止损 %", type=input.float)
float coolBars  = input(48.0, "离场后冷却根数", type=input.float)
float maxBars   = input(0.0,  "时间止损根数 (0=关)", type=input.float)

ma200 = sma(close, 200)
vol96 = sma(volume, 96)
volR  = vol96 > 0 ? volume / vol96 : 0
brk   = close > highest(high, brkLen)[1]

plot(ma200, color=color.orange)
plot(highest(high, 100), color=color.gray)

// 状态必须用 var（否则每根 bar 重置 → 止损永不触发）
var float stopPx  = 0.0
var float entryPx = 0.0
var float hiSince = 0.0
var float failPx  = 0.0
var bool  armed   = false
var float heldN   = 0.0
var float coolN   = 0.0

if (coolN > 0)
    coolN := coolN - 1

if (strategy.position_size <= 0)
    if (stopPx > 0)
        coolN := coolBars            // 上一次刚离场 → 进入冷却
    stopPx := 0.0
    armed := false
    hiSince := 0.0
    heldN := 0.0
    entryPx := 0.0
else
    if (stopPx == 0)
        // 新成交：按实际成交均价初始化（止损从下一根起生效）
        entryPx := strategy.position_avg_price
        stopPx := entryPx * (1 - slPct / 100)
        // 突破位 = 成交那根之前的 100 根最高价；收盘跌回其下方即视为突破失败
        failPx := useFailStop >= 0.5 ? highest(high, brkLen)[1] : 0.0
        hiSince := high
        armed := false
        heldN := 0.0
    else
        // 先用「上一根收盘已确定」的止损判定离场
        if (low <= stopPx)
            strategy.close("M", comment="STOP " + tostring(close))
            stopPx := 0.0
        // 突破失败：收盘跌回突破位下方 → 假突破，立刻离场（成本远低于固定 8% 止损）
        if (stopPx > 0 and failPx > 0 and close < failPx)
            strategy.close("M", comment="FAIL " + tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and maxBars > 0 and heldN >= maxBars)
            strategy.close("M", comment="TIME " + tostring(close))
            stopPx := 0.0

    hiSince := math.max(hiSince, high)
    if (bePct > 0 and armed == false and high >= entryPx * (1 + bePct / 100))
        armed := true
    if (armed)
        stopPx := math.max(stopPx, entryPx)
    stopPx := math.max(stopPx, hiSince * (1 - trailPct / 100))
    heldN := heldN + 1

// 入场（引擎在下一根开盘成交）
if (strategy.position_size <= 0 and coolN <= 0 and brk and volR >= volMult and (useMA200 < 0.5 or close > ma200))
    strategy.entry("M", strategy.long, qty=notional / close, comment="WAVE " + tostring(close))
