//@version=6
// ============================================================================
// MainWave —— 主升浪做多（1h）  ·  v6 迁移版
//
// 迁移自同目录同名的 v4 版本（MainWave.pine）。仅做 v4 → v6 的语法迁移：
//   study/indicator 命名空间、ta.* / str.* 前缀、input.* 构造器、
//   strategy() 的 default_qty_type/value 必填项、int 型周期参数。
// 策略逻辑、参数默认值、入场/离场条件、仓位口径（qty = notional / close）
// 与 v4 版本逐条保持一致 —— 用于「旧编译器 × 新 PineTS 账本」的平价校验。
//
//   入场  收盘 > 前 brkLen 根最高价（突破）
//         且 成交量 ≥ volMult × 96 根均量（放量）
//         且 收盘 > MA200（方向过滤：只在长期均线上方做多）
//   离场  初始止损 slPct% + 吊灯移动止损 trailPct%（在同一根内用已确定的止损判定）
//         可选保本；可选时间止损（默认关 —— 主升浪要耐心持有）
//   冷却  止损后 coolBars 根内不再入场
//
// 【状态变量必须用 var】否则每根 bar 重置 → 止损永不触发、仓位被拿到回测结束。
// ============================================================================
// 注：initial_capital 只影响 PineTS 券商模拟器自己的保证金模型，不影响本仓库回测引擎
//     的口径（引擎用 UI 的 initialCapital）。这里给足 100000，避免「1000 名义价值 == 1000 本金」
//     触发 PineTS 的 Margin call 微型强平，从而把干净的开仓价/数量写进账本。
strategy("MainWave", overlay=true, max_bars_back=500, initial_capital=100000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.055)

notional      = input.float(1000.0, "单笔名义价值 USDT")
// ★ 突破窗口是全篇最关键的参数：实测「越稀有越好」，且 20 天之后收敛
brkLen        = input.int(720, "突破窗口（根，720=30天）")
volMult       = input.float(1.5,  "成交量 / 96均量 ≥")
useMA200      = input.float(1.0,  "要求收盘 > MA200 (1/0)")
slPct         = input.float(12.0, "初始止损 %")
useFailStop   = input.float(0.0,  "突破失败即离场(收盘跌回突破位) (1/0)")
bePct         = input.float(0.0,  "保本触发 % (0=关)")
trailPct      = input.float(25.0, "吊灯移动止损 %")
coolBars      = input.float(48.0, "离场后冷却根数")
maxBars       = input.float(0.0,  "时间止损根数 (0=关)")

ma200 = ta.sma(close, 200)
vol96 = ta.sma(volume, 96)
volR  = vol96 > 0 ? volume / vol96 : 0
brk   = close > ta.highest(high, brkLen)[1]

plot(ma200, color=color.orange)
plot(ta.highest(high, 100), color=color.gray)

// 状态必须用 var（否则每根 bar 重置 → 止损永不触发）
var float stopPx  = 0.0
var float entryPx = 0.0
var float hiSince = 0.0
var float failPx  = 0.0
var bool  armed   = false
var float heldN   = 0.0
var float coolN   = 0.0

if (coolN > 0)
    coolN := coolN - 1

if (strategy.position_size <= 0)
    if (stopPx > 0)
        coolN := coolBars            // 上一次刚离场 → 进入冷却
    stopPx := 0.0
    armed := false
    hiSince := 0.0
    heldN := 0.0
    entryPx := 0.0
else
    if (stopPx == 0)
        // 新成交：按实际成交均价初始化（止损从下一根起生效）
        entryPx := strategy.position_avg_price
        stopPx := entryPx * (1 - slPct / 100)
        // 突破位 = 成交那根之前的 brkLen 根最高价；收盘跌回其下方即视为突破失败
        failPx := useFailStop >= 0.5 ? ta.highest(high, brkLen)[1] : 0.0
        hiSince := high
        armed := false
        heldN := 0.0
    else
        // 先用「上一根收盘已确定」的止损判定离场
        if (low <= stopPx)
            strategy.close("M", comment="STOP " + str.tostring(close))
            stopPx := 0.0
        // 突破失败：收盘跌回突破位下方 → 假突破，立刻离场
        if (stopPx > 0 and failPx > 0 and close < failPx)
            strategy.close("M", comment="FAIL " + str.tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and maxBars > 0 and heldN >= maxBars)
            strategy.close("M", comment="TIME " + str.tostring(close))
            stopPx := 0.0

    hiSince := math.max(hiSince, high)
    if (bePct > 0 and armed == false and high >= entryPx * (1 + bePct / 100))
        armed := true
    if (armed)
        stopPx := math.max(stopPx, entryPx)
    stopPx := math.max(stopPx, hiSince * (1 - trailPct / 100))
    heldN := heldN + 1

// 入场（引擎/券商在下一根开盘成交）
if (strategy.position_size <= 0 and coolN <= 0 and brk and volR >= volMult and (useMA200 < 0.5 or close > ma200))
    strategy.entry("M", strategy.long, qty=notional / close, comment="WAVE " + str.tostring(close))
