//@version=6
// ============================================================================
// PumpAmbush —— 埋伏型暴涨捕获（1h）  ·  v6 迁移版
//
// 迁移自同目录同名的 v4 版本（PumpAmbush.pine）。仅做 v4 → v6 的语法迁移：
//   strategy() 位置参数、ta.* / str.* 前缀、input.* 构造器、
//   default_qty_type/value 必填项。策略逻辑、参数默认值、入场/离场条件、
//   仓位口径（qty = notional / close）与 v4 版本逐条保持一致。
//
// 【为什么是这套规则】纯统计检验结论（K=72 根预测窗，基线 5.72%）：
//   真正有效的启动前夜特征只有一个：**48 根振幅收敛到 35% 以内**
//   （精度是基线的 3.7 倍，且覆盖 88% 的暴涨段）。
//   「量枯竭」「波动压缩」实测无效；且**不要给这个条件加任何附加过滤**。
//
// 【策略结构】在横盘里布仓，止损放在区间下沿附近；若 72 根内没启动就时间止损走人；
// 若启动则用 10% 吊灯移动止损跟随主升段。
//
// 【仓位】固定名义价值 qty = notional / 价格。
// ============================================================================
// 注：initial_capital 只影响 PineTS 券商模拟器自己的保证金模型，不影响本仓库回测引擎
//     的口径（引擎用 UI 的 initialCapital）。这里给足 100000，避免「1000 名义价值 == 1000 本金」
//     触发 PineTS 的 Margin call 微型强平。
strategy("PumpAmbush", overlay=true, max_bars_back=500, initial_capital=100000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.055)

// ---------------- 参数 ----------------
notional  = input.float(1000.0, "单笔名义价值 USDT")
rangePct  = input.float(35.0, "48根振幅 < %")
maxPos    = input.float(100.0, "只在区间下 X% 处布仓 (100=不限)")
useLowStop = input.float(0.0, "止损放48根低点下方 (1/0)")
slPct     = input.float(15.0, "初始止损 %（useLowStop=0 时生效）")
trailArm  = input.float(0.0,  "移动止损激活所需浮盈 % (0=立即)")
trailPct  = input.float(10.0, "吊灯移动止损 %")
maxBars   = input.float(72.0, "时间止损 K线数")

// ---------------- 信号：48 根振幅收敛 ----------------
hi48 = ta.highest(high, 48)
lo48 = ta.lowest(low, 48)
range48 = close > 0 ? (hi48 - lo48) / close : 1
narrow = range48 < rangePct / 100
// 收盘价在 48 根区间里的位置：0 = 贴近区间最低，100 = 贴近区间最高
posInRange = hi48 > lo48 ? ((close - lo48) / (hi48 - lo48)) * 100 : 0

plot(hi48, color=color.gray)
plot(lo48, color=color.gray)

// ---------------- 状态（必须用 var，否则每根 bar 都会重置 → 止损永不触发）----------------
var float stopPx  = 0.0
var float entryPx = 0.0
var float hiSince = 0.0
var bool  armed   = false
var float heldN   = 0.0
var bool  canEnter = true

// 每段横盘只布一次仓：条件消失后才重新武装，避免同一段横盘被反复进出
if (narrow == false)
    canEnter := true

if (strategy.position_size <= 0)
    stopPx := 0.0
    armed := false
    hiSince := 0.0
    heldN := 0.0
    entryPx := 0.0
else
    if (stopPx == 0)
        entryPx := strategy.position_avg_price
        // 两种止损口径：固定百分比，或「放在 48 根区间下沿下方 1%」
        stopPx := useLowStop >= 0.5 ? lo48 * (1 - 0.01) : entryPx * (1 - slPct / 100)
        hiSince := high
        armed := false
        heldN := 0.0
    else
        // 先用「上一根收盘已确定」的止损判定离场
        if (low <= stopPx)
            strategy.close("A", comment="STOP " + str.tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and heldN >= maxBars and close <= entryPx)
            strategy.close("A", comment="TIME " + str.tostring(close))
            stopPx := 0.0

    hiSince := math.max(hiSince, high)
    if (trailArm <= 0 or hiSince >= entryPx * (1 + trailArm / 100))
        stopPx := math.max(stopPx, hiSince * (1 - trailPct / 100))
    heldN := heldN + 1

// 布仓（引擎在下一根开盘成交）
if (strategy.position_size <= 0 and canEnter and narrow and posInRange <= maxPos)
    strategy.entry("A", strategy.long, qty=notional / close, comment="AMBUSH " + str.tostring(close))
    canEnter := false
