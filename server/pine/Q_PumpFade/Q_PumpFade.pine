//@version=6
// ============================================================================
// Q_PumpFade —— 「暴涨衰竭」做空 v1  · v6
//
// 【标的】Q/USDT:USDT（Binance USDT 本位永续）· 1h · 2025-10-17 ~ 2026-10-17
//
// 【复盘结论（多维度的原始数据见配套 markdown）】
//   · 一年 +213%（0.0239 → 0.0748），但中途自 2025-10-24 顶部回撤 -82.4%；
//     近 7 天又 +140%、近 14 天 +242%，当前贴着历史新高 ——
//     这是**极端脉冲型**标的：单根最大 -53.7%、最大 +83.0%，ATR24 中位 2.33%、当前 5.36%。
//   · 1h 上的动量持续性为**负**（1/3/6/12/24 根同向率 45.8%~48.2%，E[sign·r] 全为负）
//     → 均值回归占主导，**不适合趋势追空**。
//   · 实测各类做空信号（持仓 k 根、含双边手续费）：
//       追空类（单根阴线≤-8% / 24h跌>10%创新低 / EMA空头排列+阴线）
//         → 全部负期望（均 -2.5% ~ -9.0%），因为它们常常是暴力反弹的前奏；
//       反转型（暴涨后 fade）
//         → 正期望，且信号越严期望越高：
//            24h 涨 ≥40%                     61 笔  k=12 均 +5.45% 胜 66%
//            24h 涨 ≥40% 且 收盘 > EMA20×1.15  32 笔  k=12 均 +11.96% 胜 81%
//            24h 涨 ≥40% 且 RSI14 ≥80        12 笔  k=6  均 +18.40% 胜 92%（浮亏仅 11.6%）
//            24h 涨 ≥50%                     24 笔  k=24/48 均 +13.7%/15.6% 胜 71%/79%
//         「24h涨≥40% + RSI≥80」的**平均最大浮亏只有 11.6%**，
//         而放宽到「24h涨≥40%」时浮亏 18.9% —— RSI 超买是控制回撤的关键过滤器。
//   · 出场设计的障碍分析很明确：**任何固定止损/固定止盈都是负期望**
//       （止损率 60%~80%，TP10%/SL16% 仅 +0.09%/笔），
//       只有**跟随型移动止损**给出正期望；引擎实测（含手续费，名义 200/本金 1000）：
//         24h≥40% + 偏离≥15% + 立即吊灯8% + 入场价上限 16% + 时间止损 168 根
//           → 17 笔 · 净利 +23.84% · 最大回撤 -5.29% · 胜 59% · 盈亏比 2.17 · 盈利因子 3.10
//         同入场换成「浮盈 10% 才激活吊灯」→ +17.62%（仍为正，但更弱）
//         收紧初始止损到 12% → -3.69%（被脉冲插针打掉）；放宽到 20% → +14.42%
//       门槛敏感性：涨阈 35% → +5.1%、40% → +23.8%、45% → +10.5%、55% → +14.6%
//         （40% 是真实的 regime 分界：不到 40% 的「涨」不足以反向做空），
//         偏离 10/15/20% 三档结果几乎相同（参数是平的）。
//
// 【跨品种检验 —— 必须诚实看待】
//   同参数近一年：Q +23.84% / BANK +0.43% / AGT -11.97% / AKE -14.88%；
//   大盘币（ETH/SOL/DOGE/PUMP）一年内 24h 涨幅从未达到 40%，**0 信号**。
//   → 本策略是「小市值脉冲币 + Q 这个标的」的专用策略，**不可跨品种推广**。
//
// 【样本与盲区（务必读）】
//   · 全年只有 17 笔（平均持仓 2.1 根），统计置信度有限。
//     分段：2025-11 ~ 2026-01 六笔净 +70.1 USDT（约 +7.0%）、
//           2026-05 ~ 2026-09 十一笔净 +168.2 USDT（约 +16.8%），两段都为正。
//   · 收益依赖少数尾部：2026-09-27 那天连续拉升后断崖，当天 5 笔里 2 笔各 +43%/+47%；
//     最大连亏 3 笔，盈利因子 3.10 —— 结果被极少数大赢单主导。
//   · 有 2 笔实际亏损超出 16% 的止损上限（-20.3% / -16.5%）：脚本自平是按**下一根开盘**成交，
//     跳空时止损价并不保证是成交价。
//   · 逆势做空脉冲币的尾部风险极高（该币单根最大 +83%），因此默认名义价值只给 200。
// ============================================================================
//
// 【入场（做空）】
//   ① 近 pumpWin 根涨幅 ≥ pumpMin%（默认 24 根 ≥ 40%）   —— 必须是「已经拉爆」的标的
//   ② 收盘 ≥ EMA20 × (1 + maDev%)（默认 +15%）          —— 远离均线，短期严重偏离
//   ③ 可选 RSI(rsiLen) ≥ useRsi（默认 0 = 关；开 80 时样本少但浮亏最小）
//   满足的该根收盘出信号，引擎在**下一根开盘**做空
//
// 【离场】
//   · 吊灯移动止损：止损 = min(入场价 × (1 + slPct%), 入场后最低价 × (1 + trailPct%))，只下移；
//     trailArm% > 0 时，吊灯要等浮盈达标才激活（默认 0 = 立即生效，Q 上实测最优）
//   · 通过 plot(title="STOP") 把止损位透传给引擎做**盘中止损**，插针/瀑布按止损价成交
//   · 时间止损：持仓 maxBars 根仍浮亏 → 平仓
//   · 可选分批止盈（默认关）
//   离场判定一律用「上一根收盘就已确定」的止损价，不用本根 low 设、本根 high 触发。
//
// 【仓位】qty = notional / 收盘价（显式 qty 优先于界面「仓位比例 × 杠杆」）。
//   默认 notional=200：1000 本金下单笔最大亏损 ≈ 20% × 16% ≈ 账户 3.2%。
// ============================================================================
strategy("Q_PumpFade", overlay=true, max_bars_back=500, initial_capital=1000,
  default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.percent, commission_value=0.055)

// ---------------- 入场参数 ----------------
notional   = input.float(200.0, "单笔名义价值 USDT")
pumpWin    = input.int(24,      "涨幅观察窗口（根）")
pumpMin    = input.float(40.0,  "窗口涨幅 ≥ %")
maLen      = input.int(20,      "偏离参考均线长度")
maDev      = input.float(15.0,  "收盘高于均线 ≥ %")
useRsi     = input.float(0.0,   "RSI 下限（0=关）")
rsiLen     = input.int(14,      "RSI 长度")

// ---------------- 离场参数 ----------------
slPct      = input.float(16.0,  "吊灯止损上限 %（入场价）")
tp1Pct     = input.float(0.0,   "分批止盈 %（0=关）")
trailArm   = input.float(0.0,   "吊灯激活所需浮盈 %（0=立即）")
trailPct   = input.float(8.0,   "吊灯移动止损 %")
maxBars    = input.int(168,     "时间止损 K 线数")

// ---------------- 指标 ----------------
emaRef = ta.ema(close, maLen)
ema200 = ta.ema(close, 200)
rsi    = ta.rsi(close, rsiLen)
pump   = close / close[pumpWin] - 1
devOk  = close >= emaRef * (1 + maDev / 100)
rsiOk  = useRsi < 0.5 or rsi >= useRsi

plot(emaRef, color=color.orange)
plot(ema200, color=color.green)

entryCond = pump >= pumpMin / 100 and devOk and rsiOk

// ---------------- 持仓状态（必须用 var）----------------
var float stopPx  = 0.0
var float entryPx = 0.0
var float loSince = 0.0
var bool  tp1Done = false
var float heldN   = 0.0

if (strategy.position_size == 0)
    stopPx := 0.0
    entryPx := 0.0
    loSince := 0.0
    tp1Done := false
    heldN := 0.0
else if (strategy.position_size < 0)
    if (stopPx == 0)
        // 新成交那一根：按成交均价初始化「止损上限」，之后由吊灯只下移地收紧
        entryPx := strategy.position_avg_price
        stopPx := entryPx * (1 + slPct / 100)
        loSince := low
        tp1Done := false
        heldN := 0.0
    else
        // 1) 先用「上一根收盘时已确定」的止损 / 止盈判定离场
        if (high >= stopPx)
            strategy.close("S", comment="STOP " + str.tostring(close))
            stopPx := 0.0
        if (stopPx > 0 and tp1Pct > 0 and tp1Done == false and low <= entryPx * (1 - tp1Pct / 100))
            strategy.close("S", qty_percent=50, comment="TP1 " + str.tostring(close))
            tp1Done := true
        if (stopPx > 0 and heldN >= maxBars and close >= entryPx)
            strategy.close("S", comment="TIME " + str.tostring(close))
            stopPx := 0.0

    // 2) 再用本根收盘信息更新止损，供下一根使用
    loSince := math.min(loSince, low)
    if (trailArm <= 0 or loSince <= entryPx * (1 - trailArm / 100))
        stopPx := math.min(stopPx, loSince * (1 + trailPct / 100))
    heldN := heldN + 1

// 开仓（引擎在下一根开盘成交）
if (strategy.position_size == 0 and entryCond)
    strategy.entry("S", strategy.short, qty=notional / close, comment="FADE " + str.tostring(close))

// 止损位输出：title 必须叫 STOP —— 适配器按这个名字把它接成引擎的盘中止损。
// 空仓时 stopPx = 0，画 na 表示「本根没有止损」。
plot(stopPx > 0 ? stopPx : na, title="STOP", color=color.red)
